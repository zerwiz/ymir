# Ymir as a rootless Podman Quadlet (systemd --user).
#
# Install (per-user, rootless):
#   mkdir -p ~/.config/containers/systemd ~/.config/ymir
#   cp deploy/quadlet/ymir.container ~/.config/containers/systemd/
#   cp deploy/env.example ~/.config/ymir/ymir.env      # then edit (0600)
#   systemctl --user daemon-reload && systemctl --user start ymir.service
#
# The container is the isolation boundary against other services on the host.
# bwrap inside the container is OFF by default (see deploy/README.md).

[Unit]
Description=Ymir substrate — Hlidskjalf, gate API, memory well
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/oven/bun:1
ContainerName=ymir

# The checkout, bind-mounted; state lives with it, so updates are `git pull`.
# `:Z` relabels for SELinux (harmless where SELinux is off).
Volume=%h/dev/Way-Of/ymir:/opt/ymir:Z

# The operator's HOME, so the container's YMIR_HOME resolves to the same place the
# host's does. Without it every runtime path falls back to $HOME/Documents/ymirhome:
# the well finds no engram, the visualizer finds no smithy DB, the cron status reads
# the wrong state dir, and the ledger looks in a directory that does not exist.
# Both sides are `%h`: the container sees the operator's home at its own path, so the
# mount, the mask below, and the host all spell one path instead of three guesses.
Volume=%h/Documents/Ymir:%h/Documents/Ymir:Z

# THE VAULT IS NOT THE CONTAINER'S (the reviewer's item 5, 2026-11-12; masked 2026-11-16).
# The home mount above used to hand the container `hodd/secrets` whole — the age KEY and
# the encrypted file side by side — so a container that could read the home could decrypt
# the vault: the boundary protected nothing it was built to protect. An empty tmpfs over
# that one path closes it without widening anything else.
#
# What this costs, said plainly: inside the container `bin/vault/hodd.sh` can no longer
# decrypt. A service that needs a vault value inside the container gets it from
# `ymir.env` (0600, the EnvironmentFile above), which the operator writes; the sealed
# vault stays on the host, where its key already lives. The mail desk, the Telegram seat
# and the Nornir jobs read the vault from the host, not from here.
# `%h/Documents/Ymir/hodd/secrets` must match the home volume above; the gate
# `bin/gates/checks.d/0495-container-hides-the-hoard.sh` fails when the two drift.
Tmpfs=%h/Documents/Ymir/hodd/secrets:size=1m,ro

# The harness config (~/.pi): the model registry and the MCP servers the lifecycle
# smoke test probes.
Volume=%h/.pi:%h/.pi:Z

WorkingDir=/opt/ymir
EnvironmentFile=%h/.config/ymir/ymir.env

# Host ports, bound to LOOPBACK only (127.0.0.1) so Ymir is never exposed on the
# host's external interfaces — a shared server stays shared, not public. 5-digit
# so a shared host is unlikely to collide; keep in step with HLIDSKJALF_PORT /
# HLIDSKJALF_API_PORT / SMIDJA_VIZ_API_PORT. The well/Bifrost stay internal.
PublishPort=127.0.0.1:38889:38889
PublishPort=127.0.0.1:38888:38888
PublishPort=127.0.0.1:54370:54370

# Hardening: rootless, no new privileges, drop every capability. Ymir needs none.
NoNewPrivileges=true
DropCapability=ALL
Tmpfs=/tmp

# Map the host user so the bind-mounted checkout stays owned by you.
UserNS=keep-id

# --- bwrap inside the container (OPTIONAL; loosens the boundary) --------------
# Enable only if you want per-command bwrap confinement. Uncommenting grants the
# container the ability to create nested namespaces.
# AddCapability=SYS_ADMIN
# SecurityOpt=seccomp=unconfined

Exec=bash -lc 'cd /opt/ymir && bash scripts/start.sh'

[Service]
Restart=on-failure
TimeoutStartSec=0

[Install]
WantedBy=default.target
