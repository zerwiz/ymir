#!/usr/bin/env python3
"""
tasks-cli — AXI-compliant Task Management CLI

Follows the Agent eXperience Interface (AXI) specification from Ymir Architecture.md #151.
Uses TOON (Token-Oriented Object Notation) for stdout output.

TOON provides ~40% token savings over equivalent JSON while remaining readable by agents.
"""

import sys
import argparse


# Task state store (in-memory for demo)
tasks = [
    {"id": "1", "title": "Fix auth bug", "state": "open"},
    {"id": "2", "title": "Add pagination", "state": "open"},
    {"id": "3", "title": "Update docs", "state": "closed"},
]


def tout(items: list[dict], header: str = "") -> None:
    """Output TOON (Token-Oriented Object Notation) to stdout.
    
    TOON provides ~40% token savings over equivalent JSON while remaining
    readable by agents. Convert to TOON at the output boundary — keep internal
    logic on JSON.
    """
    if header:
        sys.stdout.write(header + "\n")
    for item in items:
        parts = []
        for key, value in item.items():
            # Escape any quotes in values
            val = value.replace('"', '\\"')
            parts.append(f'"{key}":"{val}"')
        sys.stdout.write("  " + ", ".join(parts) + "\n")


def list_tasks(args):
    """List tasks with optional filters."""
    state_filter = None
    assignee_filter = None
    limit = 100
    
    for i, arg in enumerate(args):
        if arg.startswith("--state="):
            state_filter = arg.split("=", 1)[1]
        elif arg.startswith("--assignee="):
            assignee_filter = arg.split("=", 1)[1]
        elif arg.startswith("--limit="):
            try:
                limit = int(arg.split("=", 1)[1])
            except ValueError:
                pass
    
    # Filter tasks
    filtered = tasks
    if state_filter:
        filtered = [t for t in filtered if t["state"] == state_filter]
    
    total = len(tasks)
    
    # AXI Spec §5: Definitive empty states
    if not filtered and not state_filter and len(tasks) == 0:
        sys.stdout.write("tasks: 0 closed tasks found in this repository\n")
        return
    
    # AXI Spec §2: Minimal default schemas (3-4 fields, not 10)
    limit = min(limit, 100)
    items = filtered[:limit] if filtered else []
    
    # Show header with 3 fields: id, title, state
    header = f"tasks[{len(items)}]{{id,title,state}}:"
    sys.stdout.write(header + "\n")
    
    for item in items:
        # Only output the 3 default fields
        sys.stdout.write(f'"{item["id"]}","{item["title"]}","{item["state"]}"\n')
    
    # AXI Spec §9: Reveal truncated lists
    if len(items) < total and total > 0:
        sys.stdout.write(f"help: Run 'tasks list' for all {total} items\n")
    
    # AXI Spec §4: Pre-computed aggregates — count always included
    # Already shown in header via items/total


def view_task(args):
    """View a single task with truncated body."""
    # AXI Spec §6: validate required args before calling any dependency
    # Take the first non-flag argument as the task ID
    task_id = None
    for arg in args:
        if not arg.startswith("--"):
            task_id = arg
            break
    
    if not task_id:
        # AXI Spec §6: Structured errors on stdout
        # Fail loud on unrecognized input, exit code 2
        error_msg = "--id is required for `view`"
        help_msg = "Run `tasks view <id>` to see truncated body. Run `tasks view <id> --full` for complete body."
        sys.stdout.write(f"error:{error_msg}\n")
        if help_msg:
            sys.stdout.write(f"help:{help_msg}\n")
        sys.exit(2)
    
    # Find the task
    task = None
    for t in tasks:
        if t["id"] == task_id:
            task = t
            break
    
    if not task:
        error_msg = f"task #{task_id} not found"
        help_msg = "Run `tasks list` to see available tasks. Check the task ID and try again."
        sys.stdout.write(f"error:{error_msg}\n")
        if help_msg:
            sys.stdout.write(f"help:{help_msg}\n")
        sys.exit(1)
    
    # AXI Spec §3: Content truncation
    body = task.get("body") or "No body"
    preview_length = 500
    body_preview = body[:preview_length]
    total_chars = len(body)
    
    # AXI Spec §8: Content first — show live data, not manual
    # TOON detail format
    fields = []
    fields.append(f'"number":"{task_id}"')
    fields.append(f'"title":"{task["title"]}"')
    fields.append(f'"state":"{task["state"]}"')
    
    if task.get("body"):
        body_display = f"{body_preview}...\n  ... (truncated, {total_chars} chars total)"
        fields.append(f'"body":"{body_display}"')
    
    # AXI Spec §9: --full escape hatch suggestion
    if task.get("body") and len(body) > preview_length:
        help_msg = f"Run `tasks view {task_id} --full` to see complete body"
        sys.stdout.write("task:\n")
        for field in fields:
            sys.stdout.write(f"  {field}\n")
        sys.stdout.write(f"help[1]: {help_msg}\n")
    else:
        # No truncation needed
        sys.stdout.write("task:\n")
        for field in fields:
            sys.stdout.write(f"  {field}\n")
    
    sys.exit(0)


def create_task(args):
    """Create a new task."""
    title = None
    body = None
    
    for i, arg in enumerate(args):
        if arg.startswith("--title="):
            title = arg.split("=", 1)[1]
        elif arg.startswith("--body="):
            # Join in case body contains = signs
            body = "=".join(arg.split("=", 1)[1:])
    
    # AXI Spec §6: Validate required flags before calling any dependency
    if not title:
        # AXI Spec §6: Structured errors on stdout
        # Fail immediately with clear error — don't prompt for it
        error_msg = "--title is required"
        help_msg = 'Run `tasks create --title "..." [--body "..."]` to add a task.'
        sys.stdout.write(f"error:{error_msg}\n")
        if help_msg:
            sys.stdout.write(f"help:{help_msg}\n")
        sys.exit(2)  # usage error
    
    # AXI Spec §6: No interactive prompts — fail immediately with clear error
    # Create new task
    new_id = str(len(tasks) + 1)
    new_task = {"id": new_id, "title": title, "state": "open", "body": body}
    tasks.append(new_task)
    
    # AXI Spec §6: exit 0 on success, including no-ops
    sys.stdout.write(f"task: #{new_id} \"{title}\" created (open)\n")
    sys.exit(0)


def close_task(args):
    """Close a task."""
    task_id = None
    
    for i, arg in enumerate(args):
        if not arg.startswith("--"):
            task_id = arg
            break
    
    if not task_id:
        error_msg = "<id> is required for `close`"
        help_msg = "Run `tasks close <id>` to close a task."
        sys.stdout.write(f"error:{error_msg}\n")
        if help_msg:
            sys.stdout.write(f"help:{help_msg}\n")
        sys.exit(2)
    
    # Find the task
    task = None
    for t in tasks:
        if t["id"] == task_id:
            task = t
            break
    
    if not task:
        error_msg = f"task #{task_id} not found"
        help_msg = "Run `tasks list` to see available tasks. Check the task ID and try again."
        sys.stdout.write(f"error:{error_msg}\n")
        if help_msg:
            sys.stdout.write(f"help:{help_msg}\n")
        sys.exit(1)
    
    # AXI Spec §6: Idempotent mutations — don't error when already closed
    if task["state"] == "closed":
        # No-op, exit 0 per AXI spec §6
        sys.stdout.write(f"task: #{task_id} already closed (no-op)\n")
        sys.exit(0)
    
    # Close the task
    task["state"] = "closed"
    sys.stdout.write(f"task: #{task_id} closed\n")
    sys.exit(0)


def main():
    """Main entry point for the tasks CLI."""
    if not sys.argv[1:]:
        # AXI Spec §8: Content first — running with no arguments shows live data
        # Not a usage manual
        # Show current tasks list
        list_tasks([])
        sys.exit(0)
    
    command = sys.argv[1]
    
    if command == "list":
        list_tasks(sys.argv[2:])
    elif command == "view":
        view_task(sys.argv[2:])
    elif command == "create":
        create_task(sys.argv[2:])
    elif command == "close":
        close_task(sys.argv[2:])
    else:
        # AXI Spec §6: Fail loud on unrecognized input
        # Reject unknown flags and arguments — never silently ignore them
        error_msg = f"unknown command: `{command}`"
        help_msg = "Valid commands: list, view, create, close. Run --help for more information."
        sys.stdout.write(f"error:{error_msg}\n")
        if help_msg:
            sys.stdout.write(f"help:{help_msg}\n")
        sys.exit(2)


if __name__ == "__main__":
    main()