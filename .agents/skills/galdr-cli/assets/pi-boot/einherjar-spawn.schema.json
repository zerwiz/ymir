{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fm-spawn Dispatch Payload",
  "type": "object",
  "required": ["task_id", "profile", "target", "payload"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^eindri-[a-z0-9-]+$",
      "description": "Unique task identifier, e.g. 'eindri-dev-20260911-001'"
    },
    "profile": {
      "type": "string",
      "enum": ["eindri-dev", "eindri-marketer", "eindri-researcher"],
      "description": "Firstmate worker profile to dispatch"
    },
    "target": {
      "type": "object",
      "required": ["worktree", "realm"],
      "properties": {
        "worktree": {
          "type": "string",
          "pattern": "^.yggdrasil/[a-z0-9-]+$",
          "description": "Yggdrasil worktree path for isolation"
        },
        "realm": {
          "type": "string",
          "enum": ["work", "personal"],
          "description": "Target tenant realm"
        }
      }
    },
    "payload": {
      "type": "object",
      "required": ["instructions", "context"],
      "properties": {
        "instructions": {
          "type": "string",
          "minLength": 10,
          "description": "Task instructions for the Eindri worker"
        },
        "context": {
          "type": "object",
          "properties": {
            "well_recall": { "type": "string" },
            "runes_context": { "type": "string" },
            "active_plan": { "type": "string" },
            "realm_env": { "type": "object" }
          }
        }
      }
    },
    "utgard": {
      "type": "object",
      "required": ["cpu", "memory", "timeout", "network", "rootless"],
      "properties": {
        "cpu": { "type": "string", "default": "2.0" },
        "memory": { "type": "string", "default": "4g" },
        "timeout": { "type": "string", "default": "300s" },
        "network": { "type": "string", "enum": ["none", "internal", "full"], "default": "none" },
        "rootless": { "type": "boolean", "default": true }
      }
    },
    "a2a": {
      "type": "object",
      "properties": {
        "agent_card_url": { "type": "string", "format": "uri" },
        "task_lifecycle": { "type": "string", "enum": ["SUBMITTED", "WORKING", "TERMINAL"] }
      }
    },
    "observability": {
      "type": "object",
      "required": ["observe_before", "carve_on_complete"],
      "properties": {
        "observe_before": { "type": "boolean", "default": true },
        "carve_on_complete": { "type": "boolean", "default": true },
        "well_endpoint": { "type": "string", "default": "http://localhost:4602/observe" }
      }
    }
  }
}