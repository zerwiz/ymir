# Ollama Modelfile for OpenCode Integration
# Based on qwen2.5-coder:7b for coding assistance

FROM qwen2.5-coder:7b

# Set parameters optimized for coding tasks
PARAMETER temperature 0.3
PARAMETER top_p 0.9
PARAMETER num_ctx 8192
PARAMETER repeat_penalty 1.1

# System prompt for coding assistant
SYSTEM """You are an expert programming assistant. You help users write, debug, and understand code.
You provide clear, concise explanations and follow best practices for the language being used.
When asked to write code, you provide working examples with brief explanations.
Always consider edge cases and write robust code."""

# Template for proper formatting
TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>
{{ .System }}<|eot_id|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>
{{ .Prompt }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>
{{ .Response }}<|eot_id|>"""