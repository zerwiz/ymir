# Ollama Modelfile for Zed Editor Integration
# Optimized for real-time code assistance in Zed

FROM qwen2.5-coder:7b

# Parameters tuned for responsive IDE assistance
PARAMETER temperature 0.2
PARAMETER top_p 0.95
PARAMETER num_ctx 4096
PARAMETER repeat_penalty 1.05
PARAMETER stop ["\n\n", "```"]

# System prompt for Zed editor integration
SYSTEM """You are an AI pair programmer integrated into the Zed editor.
Provide quick, accurate code completions and explanations.
Focus on helping users write code faster with minimal disruption.
When suggesting code, prioritize correctness and adherence to project style."""

TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>
{{ .System }}<|eot_id|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>
{{ .Prompt }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>
{{ .Response }}<|eot_id|>"""