# voice.env.example — where the house's speech engine (Kokoro) listens. One line, read by everyone.
#
# Copy this to $YMIR_HOME/config/voice.env (the private home, never this repo) and edit.
# kokoro-serve.service reads it through EnvironmentFile and binds this port; every client resolves the same
# value through bin/voice/kokoro-lib.sh. An explicit environment variable always wins over this file.
#
#   bin/voice/kokoro-lib.sh env      # what is resolved, and from where
#
# Loopback only: the engine refuses any other host. Unset, the engine's own default (port 8765) is used.
KOKORO_SERVICE_URL=http://127.0.0.1:8765
