{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zerwiz/ymir/config/eindri-dispatch.schema.json",
  "title": "config/eindri-dispatch.json",
  "description": "The dispatch profile (plan 42 \u00b7 plan 58, Phase 7): natural-language rules choosing a per-task harness/model/effort, read by bin/fleet/dispatch-profile.sh before an Eindri is seated. `use` MUST be a list \u2014 bin/fleet/dispatch-profile.sh iterates it, so a single object was silently skipped; that silence is a refusal now. The shipped template carries `<...>` model tokens on purpose and is a VALID document: it is simply not ACTIVE until the machine derives or writes a real profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rules"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "platform": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "when",
          "use"
        ],
        "properties": {
          "when": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string"
          },
          "use": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/choice"
            }
          }
        }
      }
    },
    "default": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "mode": {
      "enum": [
        "solo",
        "fleet",
        "offline"
      ],
      "description": "where the work road runs (plan 365); `ymir work mode` writes it"
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "triage",
          "worker",
          "judge",
          "mender"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "harness": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "$ref": "#/$defs/effort"
          }
        }
      },
      "description": "which model does which work; the judge must be another family than the worker"
    },
    "modes": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "solo",
          "fleet",
          "offline"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "about": {
            "type": "string"
          },
          "roles": {
            "type": "object"
          },
          "lanes": {
            "type": "object"
          }
        }
      }
    },
    "merge": {
      "type": "object",
      "properties": {
        "t0": {
          "enum": [
            "auto",
            "off"
          ]
        },
        "t1": {
          "enum": [
            "auto",
            "off"
          ]
        },
        "t2": {
          "enum": [
            "allfather"
          ]
        },
        "max_mend_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "intake": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "choice": {
      "oneOf": [
        {
          "title": "a launch",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "harness"
          ],
          "properties": {
            "harness": {
              "type": "string",
              "minLength": 1,
              "description": "a verified launch harness (opencode \u00b7 pi \u00b7 pi-signed)"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "$ref": "#/$defs/effort"
            }
          }
        },
        {
          "title": "a resolution",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resolve",
            "then"
          ],
          "properties": {
            "resolve": {
              "type": "string",
              "minLength": 1
            },
            "then": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
