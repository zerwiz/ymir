# desktop.env.example — the operator's own answers for the desktop apps.
#
# Copy this to $YMIR_HOME/config/desktop.env (the private home, never this repo) and edit.
# Every app launcher reads it before it decides anything; an explicit environment variable
# always wins over this file, so a one-off run can override it without editing.
#
#   bin/desktop/sessrumnir-launch.sh start      # Sessrúmnir
#   scripts/electron.sh start --view hlidskjalf # Hlidskjalf, Smíðja, Óðrerir
#
# The machine's own answer comes from bin/host/graphics-lib.sh; this file is the person's.

# auto | 1 | 0 — auto asks the machine (a fragile hybrid renders in software)
YMIR_DESKTOP_DISABLE_GPU=auto

# auto | wayland | x11 — which surface the windows use.
# Measured 2026-11-14 on heimdall: with the GPU off on Wayland, `auto` opens the windows
# through XWayland, because a GPU-less Electron window does not map on Wayland at all.
YMIR_DESKTOP_OZONE_PLATFORM=auto

# 1 — every app opens on the desktop you opened it from (0 for the older layout, each app
# on its own numbered desktop)
#YMIR_DESKTOP_PIN=1
