# TTD bridge — per-install configuration.
#
# Copy to `.env` (gitignored) and fill for THIS machine. Nothing here ships with
# a value, so two installs point at two different models without a code change.
TTD_MODEL_BASE_URL=http://127.0.0.1:8080/v1
# A model that can SEE, for the diagram-to-code route. Unset means the route is
# refused with exactly that reason (and the panel hides the entry).
TTD_VISION_MODEL=
TTD_MODEL=
TTD_MODEL_API_KEY=
TTD_BRIDGE_PORT=7313
TTD_BRIDGE_HOST=127.0.0.1
TTD_BRIDGE_ORIGINS=http://localhost:7311,http://127.0.0.1:7311

# AN OPTIONAL SECOND UPSTREAM, tried when the first cannot serve the request — a
# second rail, so one machine being asleep is a slower answer rather than no
# answer. It carries its OWN model and key: two machines are not one catalogue,
# and the primary's alias may not exist here. Leave blank for single-upstream
# behaviour, which is byte-identical to before this existed.
TTD_FALLBACK_MODEL_BASE_URL=
TTD_FALLBACK_MODEL=
TTD_FALLBACK_MODEL_API_KEY=
