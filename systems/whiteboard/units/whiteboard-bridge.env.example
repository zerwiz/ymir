# whiteboard-bridge.env.example — where the rail's address and key live.
#
# Copy to ~/.config/ymir/whiteboard-bridge.env with mode 600, and fill it from the
# vault (`bin/vault/hodd.sh emit secrets/platform.env`). The key is NEVER written
# into the unit file, a document, or a status line — a credential in a unit file
# is a credential nobody thinks of as one, which is how the old one leaked.

# An OpenAI-compatible rail. The house's own rail is the whiteboard's, by plan 233 §16.
TTD_MODEL_BASE_URL=https://opencode.ai/inference/go/openai/v1
TTD_MODEL=deepseek-v4.1-flash
# the value is a reference in this file; fill it in your own copy only.
TTD_MODEL_API_KEY=
# the browser origin allowed to call the bridge — never `*`
TTD_BRIDGE_ORIGINS=https://whiteboard.zerwiz.org
