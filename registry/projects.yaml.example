# Master project registry — the SHAPE only. The real registry lives in the Hoard:
#   hodd/identity/projects.yaml   (private; see RULES/04-hoard.md)
# Every project carries its GitHub block; auth is a REFERENCE, never a value.
#
# A row names its REALM. Plan 62 renamed the key `workspace:` -> `realm:` — it was
# never a workspace, and every id in workspaces.yaml.example IS a realm. Shape:
#
#   - id: my-project
#     name: My Project
#     realm: work
#     domains: [development]
#     repo: projects/my-project
#     posture: local-only
#     git: { host: github.com, owner: <you>, repo: my-project, remote: origin, default_branch: main, auth: gh }
#
# DEPRECATED: `workspace:` still resolves wherever `realm:` does — bin/registry-lib.sh
# reads both and names the old key out loud — but the row should be renamed.
projects: []
