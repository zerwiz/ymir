#!/usr/bin/env bash
# smith-gh — the `gh` a SMITH sees: everything reads, and nothing ships.
#
# WHY (plan 203 §14.2, plan 205 §2.2): a rule an agent can ignore is a suggestion. A smith may
# PUSH its branch — that is the transport to the fleet — and may never open a pull request, merge
# one, close one, or delete a repository. Those are the reviewer's acts, and the reviewer is a
# different hand with a different token.
#
# HOW IT KNOWS IT IS A SMITH, in this order:
#   1. $YMIR_SMITH is set (the spawn will export it once an identity exists — plan 205 §2.1);
#   2. the working tree IS a worker's worktree: a path containing `/.yggdrasil/`.
# Until an identity exists, (2) is the honest signal — a worker's environment is its worktree —
# and it cannot refuse the operator, who works in the project root.
#
# A refusal NAMES THE ROAD: the branch, the packet, the reviewer. It never says "not allowed".
#
# Install (a spawn prepends this directory to the agent's PATH):
#   bin/forge/smith-gh --install <dir>     # writes <dir>/gh -> this script
#
# THE ONE OPENING (2026-11-12): in a direct-PR errand the spawn exports YMIR_SMITH_PR=direct, and
# then — only then — a smith may `gh pr create` (its own branch's PR, which Glitnir reviews). Merge,
# close, reopen, repo delete and releases stay refused in every mode: the Allfather seals the merge.
#
# Usage: gh <anything>   (this is the shim; it is reached as `gh`)
# Exit: the real gh's exit code · 1 on a refused ship act · 2 on a missing gh.
set -u
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

refuse() {  # <what>
  cat >&2 <<EOF
⛔ $1 is the reviewer's act, not a smith's.
   a smith pushes a branch and writes a packet; the reviewer ships.
     · push the branch:      git push origin eins/<id>     (or smith/<id>)
     · write the packet:     bin/forge/handoff-packet.py write <id> …
     · hand it over:         the packet names branch + head sha; the reviewer fetches, refuses a
                             moved sha, runs the gates on THAT commit, then opens the PR
   See plan 203 §14.1 and plan 205 §2.2.
EOF
  exit 1
}

is_smith() {
  [ -n "${YMIR_SMITH:-}" ] && return 0
  case "$PWD/" in */.yggdrasil/*) return 0 ;; esac
  return 1
}

# The real gh: the first `gh` on PATH that is not this file.
real_gh() {
  local d
  IFS=: read -ra _dirs <<<"${PATH:-}"
  for d in "${_dirs[@]}"; do
    [ -n "$d" ] || continue
    [ -x "$d/gh" ] || continue
    [ "$(cd "$d" && pwd -P)/gh" = "$SELF" ] && continue
    printf '%s/gh' "$d"; return 0
  done
  return 1
}

case "${1:-}" in
  --install)
    dir="${2:-}"; [ -n "$dir" ] || { echo "error: --install needs a directory" >&2; exit 2; }
    mkdir -p "$dir" || exit 1
    ln -sf "$SELF" "$dir/gh" || exit 1
    printf 'smith-gh[1]{installed,as,law}:\n  "%s","gh","a smith pushes a branch and writes a packet; the reviewer ships"\n' "$dir"
    exit 0 ;;
  --version-shim) printf '1.0.0\n'; exit 0 ;;
esac

# The subcommand, read PAST every flag (2026-11-21, the judge's reviews of #870). `gh -R <repo> pr
# merge` put `-R` in $1, and gh ALSO takes `-R/--repo` between `pr` and `merge` (`gh pr -R <repo>
# merge`), so a check on "$1 $2" saw neither. The pair is the first two words that are not a flag,
# skipping each -R/--repo value wherever it stands.
sub_pair() {  # <args…> → "SUB1 SUB2"
  local w=() skip=0 a
  for a in "$@"; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    case "$a" in
      -R|--repo) skip=1 ;;
      -*) ;;
      *) w+=("$a"); [ "${#w[@]}" -ge 2 ] && break ;;
    esac
  done
  printf '%s %s' "${w[0]:-}" "${w[1]:-}"
}
read -r SUB1 SUB2 <<<"$(sub_pair "$@")"

# The merge API is the same act by another name. Matched without case, with or without a trailing
# slash or query: REST PUT …/pulls/<n>/merge, POST …/merges (a branch merged into another), and
# the GraphQL mergePullRequest / mergeBranch mutations — also when the query is read from a file
# (`--input <f>`, `-F query=@<f>`).
api_is_merge() {  # <args…>
  local a l f prev=""
  for a in "$@"; do
    l="$(printf '%s' "$a" | tr 'A-Z' 'a-z')"
    case "$l" in
      *mergepullrequest*|*mergebranch*) return 0 ;;
      */pulls/*/merge|*/pulls/*/merge/|*/pulls/*/merge\?*|*/pulls/*/merge/\?*) return 0 ;;
      repos/*/merges|/repos/*/merges|repos/*/merges/|/repos/*/merges/|*/merges\?*) return 0 ;;
    esac
    f=""
    case "$a" in *=@*) f="${a#*=@}" ;; esac
    [ "$prev" = --input ] && f="$a"
    if [ -n "$f" ] && [ -r "$f" ] && grep -qiE 'mergePullRequest|mergeBranch' "$f" 2>/dev/null; then return 0; fi
    prev="$a"
  done
  return 1
}

if is_smith; then
  # An alias is a merge by another name (`gh alias set m 'pr merge'`, then `gh m 7`): a smith may
  # not define one, and a call through an existing alias is judged on what it expands to.
  if [ "$SUB1" = alias ]; then
    case "$SUB2" in set|import) refuse "gh alias $SUB2 (an alias can hide a ship act)" ;; esac
  fi
  _real="$(real_gh || true)"
  case "$SUB1" in  # gh refuses an alias that shadows one of its own commands, so these never expand
    ""|pr|api|repo|issue|run|workflow|auth|alias|browse|gist|release|search|secret|variable|label|cache|codespace|org|project|ruleset|status|config|extension|gpg-key|ssh-key|completion|help|attestation|agent-task) _real="" ;;
  esac
  if [ -n "$_real" ] && [ -n "$SUB1" ]; then
    _exp="$("$_real" alias list 2>/dev/null | sed -n "s/^$(printf '%s' "$SUB1" | sed 's/[][\\.*^$/]/\\&/g'):[[:space:]]*//p" | head -1)"
    if [ -n "$_exp" ]; then
      case "$_exp" in '!'*) refuse "gh $SUB1 (a shell alias)" ;; esac
      # shellcheck disable=SC2086
      read -r SUB1 SUB2 <<<"$(sub_pair $_exp "${@:2}")"
      # shellcheck disable=SC2086
      if [ "$SUB1" = api ] && api_is_merge $_exp "${@:2}"; then refuse "gh api (a merge, through an alias)"; fi
    fi
  fi
  unset _real _exp
  if [ "$SUB1" = api ] && api_is_merge "$@"; then refuse "gh api (a merge)"; fi
  # The token must not leave gh (the judge's third review of #870): with it in hand, curl or any
  # language merges through the REST API and never meets this shim. A smith never prints it.
  if [ "$SUB1" = auth ]; then
    [ "$SUB2" = token ] && refuse "gh auth token (the credential leaving gh)"
    for _a in "$@"; do case "$_a" in -t|--show-token) refuse "gh auth $SUB2 --show-token (the credential leaving gh)" ;; esac; done
  fi
  case "$SUB1 $SUB2" in
    "pr create")
      [ "${YMIR_SMITH_PR:-}" = direct ] || refuse "gh $SUB1 $SUB2"
      # the maker ward (RULES/53): a PR title or body that names a model, a maker or an agent harness is refused
      # BEFORE it is opened. The ward is found beside the worktree's own bin/, never assumed.
      _guard="$(git rev-parse --show-toplevel 2>/dev/null)/bin/gates/guards/maker-guard.sh"
      if [ -r "$_guard" ]; then
        _args=("$@"); _i=0; _t=""
        while [ "$_i" -lt "${#_args[@]}" ]; do
          _a="${_args[$_i]}"; _v="${_args[$((_i+1))]:-}"
          case "$_a" in
            --title|-t) printf '%s\n' "$_v" >"${_t:=$(mktemp)}.title"; bash "$_guard" text "the PR title" "$_t.title" || exit 1; _i=$((_i+1)) ;;
            --title=*) printf '%s\n' "${_a#--title=}" >"${_t:=$(mktemp)}.title"; bash "$_guard" text "the PR title" "$_t.title" || exit 1 ;;
            --body|-b) printf '%s\n' "$_v" >"${_t:=$(mktemp)}.body"; bash "$_guard" text "the PR body" "$_t.body" || exit 1; _i=$((_i+1)) ;;
            --body=*) printf '%s\n' "${_a#--body=}" >"${_t:=$(mktemp)}.body"; bash "$_guard" text "the PR body" "$_t.body" || exit 1 ;;
            --body-file|-F) [ "$_v" != "-" ] && [ -r "$_v" ] && { bash "$_guard" text "the PR body ($_v)" "$_v" || exit 1; }; _i=$((_i+1)) ;;
          esac
          _i=$((_i+1))
        done
        [ -z "$_t" ] || rm -f "$_t" "$_t.title" "$_t.body"
      fi ;;
    "pr merge"|"pr close"|"pr reopen"|"repo delete"|"release create"|"release delete")
      refuse "gh $SUB1 $SUB2" ;;
  esac
fi

target="$(real_gh || true)"
[ -n "$target" ] || { echo "error: no gh on PATH — install the GitHub CLI, then retry" >&2; exit 2; }
exec "$target" "$@"
