#!/usr/bin/env bash
# prepare-commit-msg — the kit has no check of its own here; it only hands over to the repository's own prepare-commit-msg hook,
# so seating the kit never silences a hook the repository already had (RULES/24, hooks chain, never steal).
set -u
. "$(dirname "$0")/_common.sh"
kit_enter prepare-commit-msg
kit_chain prepare-commit-msg "$@"
