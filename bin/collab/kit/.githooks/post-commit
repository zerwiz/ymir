#!/usr/bin/env bash
# post-commit — the kit has no check of its own here; it only hands over to the repository's own post-commit hook,
# so seating the kit never silences a hook the repository already had (RULES/24, hooks chain, never steal).
set -u
. "$(dirname "$0")/_common.sh"
kit_enter post-commit
kit_chain post-commit "$@"
