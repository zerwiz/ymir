#!/usr/bin/env bash
# pre-rebase — the kit has no check of its own here; it only hands over to the repository's own pre-rebase hook,
# so seating the kit never silences a hook the repository already had (RULES/24, hooks chain, never steal).
set -u
. "$(dirname "$0")/_common.sh"
kit_enter pre-rebase
kit_chain pre-rebase "$@"
