#!/usr/bin/env bash
# Three gates: never push a protected branch, never push a red tree, and never push a behaviour change
# without its note.
#
# The tree check runs only what the project DECLARES — `package.json` scripts `check` and `test`. A
# repository with no package.json (every Elixir one in the house) has no npm tree check to fail; refusing
# it forever is not a gate, it is a lockout. Where a project declares nothing, the gates that still apply
# are the ones above and below: the protected branch, the pull request, and the fix note.
set -u

protected="master main"
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  bash scripts/gates/pr-guard.sh "${1:-origin}" "$_local_ref" "$remote_ref" "$_remote_sha" || exit 1
  case "$remote_ref" in
    refs/heads/*)
      branch="${remote_ref#refs/heads/}"
      for p in $protected; do
        if [ "$branch" = "$p" ]; then
          printf 'pre-push refused: %s is protected — open a pull request; the Allfather seals merges\n' "$branch" >&2
          exit 1
        fi
      done
      ;;
  esac
done

declares() {
  [ -f package.json ] || return 1
  if command -v node >/dev/null 2>&1; then
    node -e 'const s=(require("./package.json").scripts)||{};process.exit(s[process.argv[1]]?0:1)' "$1" 2>/dev/null
    return $?
  fi
  grep -q "\"$1\"[[:space:]]*:" package.json 2>/dev/null
}

if command -v npm >/dev/null 2>&1; then
  if declares check; then
    printf 'pre-push: the doctor\n'
    npm run --silent check || { printf '\npre-push refused: a ward found a fault\n' >&2; exit 1; }
  fi
  if declares test; then
    printf 'pre-push: the tests\n'
    npm run --silent test || { printf '\npre-push refused: a test failed\n' >&2; exit 1; }
  fi
fi

# a behaviour change carries its note
branch_head="$(git rev-parse HEAD 2>/dev/null)"
upstream="$(git rev-parse @{u} 2>/dev/null || true)"
if [ -n "$upstream" ] && [ "$upstream" != "$branch_head" ]; then
  bash scripts/gates/fixes-guard.sh "$upstream" "$branch_head" || exit 1
fi

exit 0
