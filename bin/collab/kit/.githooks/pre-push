#!/usr/bin/env bash
# pre-push — the gates at the last cheap moment, then the repository's own pre-push (hooks chain, never steal).
#
# Two roads (RULES/15): documents and handoffs go straight to the default branch; code goes by a pull request
# from its own worktree. A push to main or master that carries only documents (`kit.py road`: docs/, handoff/,
# plans/, RULES/, areas/, *.md outside the code paths, plus .docs-paths) goes in; anything else is refused there.
# An unknown file is code — the road fails closed.
#
# Then: never push work nobody can review, never push a behaviour change without its note, never change the
# referee in silence, never add a module with no test, and never push a red tree. Every gate is reachable: a
# gate written after an `exit` is a gate that never runs.
set -u
. "$(dirname "$0")/_common.sh"
kit_enter pre-push
input="$(cat)"

# gate <name> <command…> — run it, keep its words, and hand a refusal to the notice command as well.
gate() {
  local name="$1"; shift
  local out
  if out="$("$@" 2>&1)"; then
    [ -n "$out" ] && printf '%s\n' "$out" >&2
    return 0
  fi
  printf '%s\n' "$out" >&2
  kit_notify "$name" "$out"
  exit 1
}

protected="master main"
# docs_only <old-sha> <new-sha> — true when the push changes nothing but documents and handoffs.
docs_only() {
  case "${1:-}" in "") return 1 ;; esac
  case "$1" in *[!0]*) ;; *) return 1 ;; esac
  if [ -f scripts/kit.py ]; then
    python3 scripts/kit.py road "$1" "$2" >/dev/null 2>&1
    return $?
  fi
  local touched
  touched="$(git diff --name-only "$1" "$2" 2>/dev/null)" || return 1
  [ -n "$touched" ] && ! printf '%s\n' "$touched" | grep -qv '^handoff/'
}

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  case "$remote_ref" in
    refs/heads/master|refs/heads/main)
      if docs_only "$_remote_sha" "$_local_sha"; then
        printf 'pre-push: %s carries only documents and handoffs — they need no worktree and no pull request\n' "${remote_ref#refs/heads/}" >&2
        continue
      fi ;;
  esac
  case "$remote_ref" in
    refs/heads/*)
      branch="${remote_ref#refs/heads/}"
      for p in $protected; do
        if [ "$branch" = "$p" ]; then
          msg="pre-push refused: $branch is protected — code goes by a pull request; a person merges it"
          [ -f scripts/kit.py ] && msg="$msg
$(python3 scripts/kit.py road "$_remote_sha" "$_local_sha" 2>&1 | head -5)"
          printf '%s\n' "$msg" >&2
          kit_notify protected-branch "$msg"
          exit 1
        fi
      done
      ;;
  esac
  gate pr-guard bash scripts/gates/pr-guard.sh "${1:-origin}" "$_local_ref" "$remote_ref" "$_remote_sha"
done <<< "$input"

# The range this push carries: the upstream, or the base branch when the branch is new.
range_base() {
  git rev-parse @{u} 2>/dev/null && return 0
  for candidate in origin/main origin/master main master; do
    git rev-parse --verify --quiet "$candidate" >/dev/null && { printf '%s\n' "$candidate"; return 0; }
  done
  return 1
}

base="$(range_base || true)"
head="$(git rev-parse HEAD 2>/dev/null || echo HEAD)"

if [ -n "$base" ] && [ "$base" != "$head" ]; then
  [ -x scripts/gates/fixes-guard.sh ] && gate fixes-guard bash scripts/gates/fixes-guard.sh "$base" "$head"
  [ -x scripts/gates/referee-guard.sh ] && gate referee-guard bash scripts/gates/referee-guard.sh "$base" "$head"
  [ -x scripts/gates/new-module-test.sh ] && gate new-module-test bash scripts/gates/new-module-test.sh "$base" "$head"
  # a commit message never names a model, a maker or an agent harness
  [ -x scripts/gates/maker-guard.sh ] && gate maker-guard bash scripts/gates/maker-guard.sh range "$base" "$head"
  # an area nobody holds must not receive changes quietly (RULES/18)
  [ -x scripts/gates/areas-guard.sh ] && gate areas-guard bash scripts/gates/areas-guard.sh "$base" "$head"
fi

if [ -f scripts/checks.sh ]; then
  printf 'pre-push: the checks\n'
  bash scripts/checks.sh test || {
    msg="pre-push refused: a check failed — fix it, or push with --no-verify and say why in the commit"
    printf '\n%s\n' "$msg" >&2
    kit_notify checks "$msg"
    exit 1
  }
else
  printf 'pre-push: scripts/checks.sh is missing — this repository carries an older kit; nothing was checked\n' >&2
fi

printf '%s\n' "$input" | kit_chain pre-push "$@"
