#!/usr/bin/env bash
# commit-msg — a commit says what and why, in the project's tongue, and names no model or tool as its author.
set -u
. "$(dirname "$0")/_common.sh"
kit_enter commit-msg

message_file="${1:-}"
[ -r "$message_file" ] || exit 0
subject=$(head -1 "$message_file" | tr -d '\r')
words=$(printf '%s' "$subject" | wc -w)

# the maker guard: a message never names a model, a maker or an agent harness
if [ -x scripts/gates/maker-guard.sh ]; then
  bash scripts/gates/maker-guard.sh message "$message_file" || { kit_notify commit-msg "a commit message was refused for naming a model or harness"; exit 1; }
fi

# the project's tongue (RULES/22): a commit is read by every future maintainer
if [ -f scripts/kit.py ] && [ -f project.yaml ]; then
  python3 scripts/kit.py lang msg "$message_file" || { kit_notify commit-msg "a commit message was refused for its language"; exit 1; }
fi

case "$subject" in
  Merge*|Revert*|fixup!*|squash!*) kit_chain commit-msg "$@"; exit $? ;;
esac

if [ "$words" -lt 3 ]; then
  printf 'commit-msg refused: "%s" is too short.\nhelp: say what changed and why — one imperative line, then a paragraph.\n' "$subject" >&2
  kit_notify commit-msg "a commit subject was refused as too short: \"$subject\""
  exit 1
fi
if printf '%s' "$subject" | grep -qiE '^(wip|update|updates|changes|fix|fixes|misc|temp|test)$'; then
  printf 'commit-msg refused: "%s" says nothing a reader can use.\n' "$subject" >&2
  kit_notify commit-msg "a commit subject was refused as saying nothing: \"$subject\""
  exit 1
fi
kit_chain commit-msg "$@"
