# dex.env — copy to dex.env beside docker-compose.yml, chmod 600, and NEVER commit the filled copy.
#
# The issuer URL itself is NOT here: Dex does not expand it, so it is written in config.yaml (and must
# equal the door's --oauth-issuer exactly). Only the connector ids and secrets below are read from here.

# GitHub: github.com → Settings → Developer settings → OAuth Apps → callback <issuer>/callback
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET

# Google: console.cloud.google.com → Credentials → OAuth client ID (Web) → redirect <issuer>/callback
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# The door's own confidential client secret, invented once: openssl rand -hex 32
GIMLE_MCP_CLIENT_SECRET=REPLACE_WITH_openssl_rand_hex_32
