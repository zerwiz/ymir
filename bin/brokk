#!/usr/bin/env bash
# brokk — the primary agent's CLI (Brokk, the bellows-smith).
#
# One front door for the runtime: the seat, the crew (Eindri), the tree
# (Yggdrasil), the well (Mimirsbrunn), and the ledger (Runes). Thin dispatcher:
# it calls the owning scripts, never reimplements them. Galdr-style TOON.
#
# Usage:
#   brokk status
#   brokk agent spawn <id> <project> --mode <no-mistakes|direct-PR|local-only> [--scout] [--isolation auto|on|off] [--harness H]
#   brokk agent list | status <id> | merge <id> | cleanup <id> [--force]
#   brokk recall <query> [--k N] | observe <text> [--tags a,b] | timeline [--entity X]
#   brokk runes [n]
#   brokk version | help
set -u

VERSION="1.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
B="$SCRIPT_DIR"

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }

CMD="${1-}"; shift || true
case "$CMD" in
  version|-v|-V|--version) printf '%s\n' "$VERSION"; exit 0 ;;
  help|-h|--help|"") usage; exit 0 ;;
esac

status() {
  local lock started cron bridge well lock_file
  # The primary's lock is machine-global; an Eindri-home's is per-home. The
  # resolved path is recorded in state/.lock-path by gleipnir_lock_acquire.
  lock_file="$B/../state/.lock"
  [ -r "$B/../state/.lock-path" ] && lock_file=$(tr -d '[:space:]' <"$B/../state/.lock-path")
  lock=$(tr -d '[:space:]' <"$lock_file" 2>/dev/null || echo '—')
  [ -e "$B/../state/.session-start-complete" ] && started=yes || started=no
  cron=$(bash "$B/nornir-cron-start.sh" --status 2>/dev/null | sed 's/^cron: //')
  bridge=$(bash "$B/bifrost-bridge.sh" --status 2>/dev/null | tail -1 | sed 's/.*,"//; s/"$//')
  well=$(bash "$B/mimir.sh" health 2>/dev/null | tail -1 | cut -d, -f2)
  printf 'brokk[1]{lock,seated,cron,bridge,well}:\n  "%s","%s","%s","%s",%s\n' "$lock" "$started" "$cron" "$bridge" "$well"
}

case "$CMD" in
  status) status ;;

  agent)
    AG="${1-}"; shift || true
    case "$AG" in
      spawn) exec "$B/einherjar-spawn.sh" "$@" ;;
      list) exec "$B/yggdrasil.sh" list ;;
      status) exec "$B/yggdrasil.sh" status "$@" ;;
      merge) exec "$B/yggdrasil.sh" merge "$@" ;;
      cleanup) exec "$B/yggdrasil.sh" cleanup "$@" ;;
      *) printf 'error: unknown agent subcommand %s\nhelp: brokk agent [spawn|list|status|merge|cleanup]\n' "${AG:-}" >&2; exit 2 ;;
    esac
    ;;

  recall) exec "$B/mimir.sh" recall "$@" ;;
  observe) exec "$B/mimir.sh" observe "$@" ;;
  timeline) exec "$B/mimir.sh" timeline "$@" ;;

  runes)
    n=${1:-10}
    printf 'runes[%s]{ts,actor,event}:\n' "$n"
    grep '^{' "$B/../workspace/memory/runes_audit.md" 2>/dev/null | tail -n "$n" | while IFS= read -r l; do
      printf '%s\n' "$l" | python3 -c 'import json,sys
e=json.loads(sys.stdin.read())
print("  \"%s\",\"%s\",\"%s\"" % (e.get("timestamp",""), e.get("actor",""), e.get("event","")))' 2>/dev/null
    done
    ;;

  *) printf 'error: unknown command %s\nhelp: brokk [status|agent|recall|observe|timeline|runes|version|help]\n' "$CMD" >&2; exit 2 ;;
esac
