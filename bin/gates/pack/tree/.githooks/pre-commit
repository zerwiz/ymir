#!/usr/bin/env bash
# pre-commit — every commit meets the gates (bin/gates/run-gates.sh staged). Part of Ymir's gate pack; seated by
# bin/gates/install-hooks.sh. A refusal is fixed in the change, never with --no-verify.
root="$(git rev-parse --show-toplevel)"
exec bash "$root/bin/gates/run-gates.sh" staged
