# An example of the hound's unit, with the heartbeat watchdog. __YMIR_ROOT__ is the placeholder the
# installer replaces; the unit that is actually installed is rendered from
# tools/mill/systemd/garmr-hound.service by `bin/ward/garmr.sh install`. This example carries no
# machine and no home — the repository is public (RULES/04).
[Unit]
Description=Garmr the hound — what executes, who touches the sensitive shelves, what listens and what leaves (read-only senses)
After=network-online.target

[Service]
Type=notify
User=root
Group=root
ExecStart=/usr/bin/python3 __YMIR_ROOT__/bin/ward/garmr/hound.py
Restart=always
RestartSec=10
WatchdogSec=120
NotifyAccess=main
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/log/ymir/garmr /var/log/ymir/garmr/state

[Install]
WantedBy=multi-user.target
