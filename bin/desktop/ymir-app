#!/usr/bin/env bash
# ymir-app — the ONE command every Ymir shortcut runs, on every platform (plan 275 S11).
#
#   ymir-app <hlidskjalf|smidja|odrerir|sessrumnir|bilskirnir|rodd> [args…]
#   ymir-app --list | --where
#
# A shortcut never names a tree again. Measured: on 2026-10-22 every launcher named a dead /tmp/npm-pretest path,
# on 2026-11-09 five named a worker's worktree, and this file's own first version (plan 118) opened the npm global
# copy of October (v0.1.53). This one resolves the PINNED runtime when it runs — a link to the current release
# after `bin/engine/release.sh adopt` — so an update, a rollback or a moved checkout can never break an icon.
# It is installed to ~/.local/bin/ymir-app by bin/desktop/shortcuts.sh (install and every update).
set -u
pin="${YMIR_RUNTIME_DIR:-}"
if [ -z "$pin" ]; then
  conf="${YMIR_HOME:-$HOME/Documents/ymirhome}/config/runtime.env"   # allow-home-default: the one home
  [ -r "$conf" ] && pin="$(sed -n 's/^[[:space:]]*YMIR_RUNTIME_DIR[[:space:]]*=[[:space:]]*//p' "$conf" | head -1 | tr -d "\"'")"
  pin="${pin//\$\{HOME\}/$HOME}"; pin="${pin//\$HOME/$HOME}"
fi
[ -n "$pin" ] || pin="$HOME/ymir-runtime"
[ -d "$pin/apps" ] || { printf 'ymir-app: no Ymir runtime at %s — run bin/engine/ymir-install.sh\n' "$pin" >&2; exit 1; }
export YMIR_RUNTIME_DIR="$pin"

app="${1:-}"; [ $# -gt 0 ] && shift

# The app opens on the desktop the user opened it from (2026-11-14, at the Allfather's word: "make so all apps
# open on the screen the user opens them in"). The desktop is read at the click; a watcher then waits for the
# app's window — a new one, or one already open on another desktop — moves it here and focuses it. A pin to a
# fixed desktop is opt-in (YMIR_DESKTOP_PIN=1, bin/desktop/desktop-place.sh), and YMIR_APP_FOLLOW=0 turns this off.
follow_here() {  # <window class>
  [ "${YMIR_APP_FOLLOW:-1}" = 1 ] && [ "${YMIR_DESKTOP_PIN:-0}" != 1 ] || return 0
  command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || return 0
  local here; here="$(hyprctl activeworkspace -j 2>/dev/null | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("id",""))
except Exception: pass' 2>/dev/null)"
  case "$here" in ''|-*|0) return 0 ;; esac   # a special or unknown desktop: leave the window where it maps
  export YMIR_APP_FOLLOWING=1                 # the start scripts skip their own jump to the window's old desktop
  ( trap '' HUP; bring_here "$1" "$here" </dev/null >/dev/null 2>&1 & )   # outlives the exec below
}

bring_here() {  # <window class> <desktop id> — wait up to 30 s for the window, move it here, focus it
  local cls="$1" here="$2" i=0 at addr ws
  while [ $i -lt 120 ]; do
    at="$(hyprctl clients -j 2>/dev/null | CLS="$cls" python3 -c '
import json,os,sys
try: ws=json.load(sys.stdin)
except Exception: sys.exit(0)
for w in ws:
    if w.get("class")==os.environ["CLS"] and w.get("mapped",True):
        print(w["address"], w["workspace"]["id"]); break' 2>/dev/null)"
    if [ -n "$at" ]; then
      addr="${at% *}" ws="${at#* }"
      if [ "$ws" != "$here" ]; then
        hyprctl dispatch "hl.dsp.window.move({ window = \"address:$addr\", workspace = $here })" 2>/dev/null | grep -qx ok \
          || hyprctl dispatch movetoworkspacesilent "$here,address:$addr" >/dev/null 2>&1
      fi
      hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" 2>/dev/null | grep -qx ok \
        || hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
      return 0
    fi
    sleep 0.25; i=$((i+1))
  done
}

case "$app" in hlidskjalf|smidja|odrerir|sessrumnir|bilskirnir|rodd) follow_here "ymir-$app" ;; esac   # app_class: ymir-<app>

case "$app" in
  hlidskjalf|smidja|odrerir) exec bash "$pin/scripts/electron.sh" start --view "$app" "$@" ;;
  sessrumnir) exec bash "$pin/bin/desktop/sessrumnir-launch.sh" start "$@" ;;
  bilskirnir) exec "$pin/apps/bilskirnir/start.sh" "$@" ;;
  rodd) systemctl --user restart ymir-rodd.service 2>/dev/null && exit 0; exec "$pin/apps/rodd/start.sh" "$@" ;;
  --where) printf '%s\n' "$pin" ;;
  --list|"") printf '%s\n' hlidskjalf smidja odrerir sessrumnir bilskirnir rodd ;;
  *) printf 'ymir-app: no app named %s (ymir-app --list)\n' "$app" >&2; exit 2 ;;
esac
