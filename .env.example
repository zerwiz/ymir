# YMIR PLATFORM - ENVIRONMENT VARIABLES
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git

# === LLM API KEYS ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LM_STUDIO_URL=http://localhost:1234

# === GITHUB ===
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_ORG=

# === CLOUDFLARE TUNNEL ===
CLOUDFLARE_TUNNEL_TOKEN=

# === GATEWAY (BIFROST) ===
BIFROST_PORT=80
BIFROST_SSL_PORT=443
HEIMDALL_OAUTH_CLIENT_ID=
HEIMDALL_OAUTH_CLIENT_SECRET=
HEIMDALL_COOKIE_SECRET=

# === REDIS (RATATOSKR) ===
REDIS_URL=redis://redis-bus:6379

# === TELEGRAM (optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# === DEPLOYMENT ===
VERCEL_TOKEN=
EXPO_TOKEN=
NETLIFY_AUTH_TOKEN=

# === DATABASE (MIMIRSBRUNN) ===
VECTOR_DB_PATH=./.agents/memory/mimirsbrunn.db
