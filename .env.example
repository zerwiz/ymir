# YMIR PLATFORM - ENVIRONMENT VARIABLES
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git

# === MODEL PROVIDER (Bifrost bridge) ===
# Pick ONE provider. The bridge serves it as an OpenAI-compatible endpoint on
# 127.0.0.1:4603 so pi can use it. No provider is forced to need a key.
#
#   opencode-go        OpenCode Zen Go gateway  — needs OPENCODE_GO_API_KEY
#   lmstudio           LM Studio on localhost   — keyless (the default fallback)
#   openai-compatible  any OpenAI-style server  — optional key
#
# Leave YMIR_MODEL_PROVIDER empty to auto-select: opencode-go when a key
# exists, otherwise the keyless local provider (lmstudio).
YMIR_MODEL_PROVIDER=
YMIR_MODEL_BASE_URL=
YMIR_MODEL_API_KEY=

# opencode-go (Zen Go) gateway key — only needed for that provider.
OPENCODE_GO_API_KEY=
# opencode (Zen) gateway key — same provider, different env var.
OPENCODE_API_KEY=

# LM Studio (keyless). The base URL must include /v1.
# RETIRED — Ymir does not use LM Studio. Port :1234 now serves Apodex
# (see the Apodex block below); this var is kept only so older configs
# that still reference it resolve to something sane.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=

# === Apodex Model Provider (llama-router lodge) ===
# Serves apodex/Apodex-1.0-mini-Q4_K_M (GGUF) on :1234, registered as a
# route on the machine's llama-router (research/planning tasks) alongside
# llama.cpp coding models on :8080. One local model at a time per router.
APODEX_BASE_URL=http://localhost:1234/v1
APODEX_MODEL=apodex/Apodex-1.0-mini-Q4_K_M
APODEX_API_KEY=not-needed-for-local

# === OTHER LLM API KEYS ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === GITHUB ===
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_ORG=

# === CLOUDFLARE TUNNELS (Gjallarhorn) ===
# Each tunnel: UUID → domains → local ports.
# Credentials live at ~/.cloudflared/<uuid>.json (NOT in this file).
# Run with: cloudflared tunnel run --config <config.yml>
# CLOUDFLARE_GJALLARHORN=ymir (ymirdell.zerwiz.org, ymirsmidjadell.zerwiz.org)
CLOUDFLARE_TUNNEL_GJALLARHORN=ymir
CLOUDFLARE_GJALLARHORN_URLS="ymirdell.zerwiz.org ymirsmidjadell.zerwiz.org"
CLOUDFLARE_GJALLARHORN_UUID=
CLOUDFLARE_GJALLARHORN_PORTS="3889 4321"
CLOUDFLARE_TUNNEL_DOJO=
CLOUDFLARE_DOJO_DOMAINS="dojo.zerwiz.org"
CLOUDFLARE_DOJO_PORTS="8038"
CLOUDFLARE_TUNNEL_DEV=
CLOUDFLARE_DEV_DOMAINS="dev-dojo.zerwiz.org"
CLOUDFLARE_DEV_PORTS="8038"
CLOUDFLARE_TUNNEL_DUAL_CHAT=
CLOUDFLARE_DUAL_DOMAINS="hersdojo.zerwiz.org hisdojo.zerwiz.org"
CLOUDFLARE_DUAL_PORTS="8396 8397"
CLOUDFLARE_TUNNEL_ANCHOR=
CLOUDFLARE_ANCHOR_DOMAINS="anchor.zerwiz.org"
CLOUDFLARE_ANCHOR_PORTS="42777"
CLOUDFLARE_TUNNEL_WAYOF=
CLOUDFLARE_WAYOF_DOMAINS="cloud.zerwiz.org team.zerwiz.org teamapp.zerwiz.org ai.zerwiz.org ws1.dev-zerwiz.org"
CLOUDFLARE_WAYOF_PORTS="4214 4321 4000 9898 3101"
CLOUDFLARE_TUNNEL_LNX=
CLOUDFLARE_LNX_DOMAINS="linuxcommand.zerwiz.org"
CLOUDFLARE_LNX_PORTS="8438"
CLOUDFLARE_TUNNEL_CLOUD=
CLOUDFLARE_CLOUD_DOMAINS="cloud.zerwiz.org"
CLOUDFLARE_CLOUD_PORTS="4214"

# === GATEWAY (BIFROST) ===
BIFROST_PORT=80
BIFROST_SSL_PORT=443
HEIMDALL_OAUTH_CLIENT_ID=
HEIMDALL_OAUTH_CLIENT_SECRET=
HEIMDALL_COOKIE_SECRET=

# === REDIS (RATATOSKR) ===
REDIS_URL=redis://redis-bus:6379

# === TELEGRAM (optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# === DEPLOYMENT ===
VERCEL_TOKEN=
EXPO_TOKEN=
NETLIFY_AUTH_TOKEN=

# === DATABASE (MIMIRSBRUNN) ===
VECTOR_DB_PATH=./.agents/memory/mimirsbrunn.db

# === CLOUDFLARE (cache purge / zone) ===
CLOUDFLARE_API_TOKEN=
# Zone ID for cache purge & DNS routes (find in Cloudflare dashboard):
CLOUDFLARE_ZONE_ID=

# === SSH (fleet access) ===
# Same key on all machines (heimdall, zerwizserver, omarchy):
# ~/.ssh/id_ed25519 (authorized_keys on each host)
SSH_PRIVATE_KEY=~/.ssh/id_ed25519

# === WayOf Teams server ===
WOT_SERVER_IP=
WOT_SERVER_USER=
WOT_SERVER_SSH_KEY=~/.ssh/id_ed25519
WOT_SERVER_PATH=
WOT_MCP_ENDPOINT=v2

# === Local model stack ===
CMD_LOCAL_MODEL=
CMD_LOCAL_URLS="http://localhost:8125 http://localhost:8086 http://localhost:8081 http://localhost:8084 http://localhost:1234 http://localhost:11434"

# === HLIDSKJALF gate login (user:password) ===
HLIDSKJALF_AUTH=

# === Ró (calm presentation) preference: on | off ===
YMIR_RO=
