#!/usr/bin/env python3
"""smidja-mcp — the Smíðja MCP server (stdio), seated in every harness.

A thin door: the work is in runner/smidja_runner/. The real path is resolved
first, so a symlink on PATH (~/.local/bin/smidja-mcp) still finds the library.
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "runner"))

from smidja_runner import mcp_server  # noqa: E402

sys.exit(mcp_server.main())
