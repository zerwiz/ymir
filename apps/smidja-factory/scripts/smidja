#!/usr/bin/env python3
"""smidja — the smithy's one command (skills/smidja-launcher).

A thin door: the work is in runner/smidja_runner/. The real path is resolved
first, so a symlink on PATH (~/.local/bin/smidja) still finds the library.
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "runner"))

from smidja_runner import cli  # noqa: E402

sys.exit(cli.main())
