# Rödd's head — the model that answers in her window.
#
# THIS IS A TEMPLATE. It ships with the repository and carries NO secret.
# The real file lives in the private home and is never committed:
#
#     $YMIR_HOME/hodd/secrets/rodd.env        (mode 0600, written by the door)
#
# Resolution order, first hit wins (bin/voice/rodd-head.py):
#   1. the environment      RODD_HEAD_MODE / _BASE_URL / _MODEL / _API_KEY
#   2. the home's secrets    the file named above
#   3. these values          the one documented default
#
# A KEY IS NAMED, NEVER PASTED. The value of RODD_HEAD_API_KEY_NAME is looked up in
# the house's vault (bin/vault/hodd.sh emit secrets/platform.env); a key the operator
# typed into Rödd's settings is written to the home's rodd.env as RODD_HEAD_API_KEY and
# is never returned to the window, never logged and never in this tree (RULES/04, /15).

# local  — the seat's own rail (llama-swap on loopback)
# online — any OpenAI-compatible endpoint the operator pays for
RODD_HEAD_MODE=local

# the local rail: filled from the seat's own catalog, never guessed in code
RODD_HEAD_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
RODD_HEAD_LOCAL_MODEL=
RODD_HEAD_LOCAL_KEY_NAME=LLAMA_SWAP_API_KEY

# the online endpoint: an OpenAI-compatible base, a model id, and the NAME of a key
# in the vault — for example an opencode-go subscription:
#   RODD_HEAD_ONLINE_BASE_URL=https://example.invalid/inference/go/openai/v1
#   RODD_HEAD_ONLINE_MODEL=some-model-id
#   RODD_HEAD_ONLINE_KEY_NAME=OPENCODE_GO_API_KEY
RODD_HEAD_ONLINE_BASE_URL=
RODD_HEAD_ONLINE_MODEL=
RODD_HEAD_ONLINE_KEY_NAME=
# some hosted endpoints refuse a plain client; the loopback proxy adds what they ask
#   plain      any OpenAI-compatible endpoint
#   opencode   x-opencode-client + x-opencode-session + a proper User-Agent
RODD_HEAD_ONLINE_CLIENT=plain
