[Desktop Entry]
Type=Application
Name=Ymir · Rödd
GenericName=The voice of Ymir
Comment=Speak with the house — its own ear, its own head, its own voice
Exec=sh -c "systemctl --user restart ymir-rodd.service || exec __YMIR_RUNTIME__/apps/rodd/start.sh"
Path=__YMIR_RUNTIME__/apps/rodd
Icon=rodd
Terminal=false
Categories=AudioVideo;Audio;
Keywords=voice;speech;talk;ymir;rodd;skirnir;
StartupNotify=true
StartupWMClass=ymir-rodd
