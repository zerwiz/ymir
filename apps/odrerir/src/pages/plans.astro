---
// plans.astro — the plans' house — the tickets' twin (strip, rich cards,
// the project-pill, presses into the reader). Same cloth, same breath.
import '../styles/cloth.css'
import '../styles/livehall.css'
const SKULD = "http://192.168.68.111:8320";
---
<html lang="en">
<head>
<meta charset="utf-8" />
<title>the plans — the roadmap</title>
<meta name="viewport" content="width=device-width, initial-scale=1" />
</head>
<body>
<div class="hall-top">
  <span><span class="rn">ᛚ</span>YMIR · THE PLANS</span>
  <span class="hall-links" style="display:inline-flex;gap:1rem;align-items:center">
    <a class="hall-back" href="/" title="the hall">← the hall</a>
    <a class="hall-back" href="/tickets" title="the tickets">the tickets →</a>
  </span>
</div>
<main class="hall-wrap" id="plans-page">
  <header class="shead rv" style="margin-bottom:1.2rem"><p class="skicker"><span class="rn">ᛚ</span>the plans · the roadmap</p></header>
  <div id="strip" style="display:grid;grid-template-columns:repeat(4,1fr);gap:.6rem;margin-bottom:.9rem"></div>
  <div class="panel rv">
    <div class="panel-head">
      <div class="panel-title"><span class="glyph" aria-hidden="true">ᛚ</span>the plans <span id="plan-count" class="mono dim" style="margin-left:.4rem"></span></div>
      <button type="button" id="new-plan-btn" class="td-act">+ new plan</button>
    </div>
    <div class="panel-body flush">
      <div class="filters" style="display:flex;gap:.55rem;align-items:center;flex-wrap:wrap;padding:.55rem .9rem;border-bottom:1px solid var(--steel-1,#2b241a)">
        <div id="ns-pills" style="display:inline-flex;gap:.3rem;flex-wrap:wrap"></div>
        <select id="f-status" style="background:var(--bg-1,#151209);color:var(--bone,#cfc3a9);border:1px solid var(--steel-1,#2b241a);border-radius:2px;padding:.35rem .6rem;font-size:.74rem"><option value="">status: any</option></select>
      </div>
      <div id="new-panel" hidden style="padding:.7rem .9rem;border-bottom:1px solid var(--steel-1,#2b241a)">
        <form id="pf" style="display:grid;gap:.6rem">
          <div style="display:flex;gap:.6rem;flex-wrap:wrap">
            <select name="namespace" id="ns-pick" style="background:var(--bg-1,#151209);color:var(--bone,#cfc3a9);border:1px solid var(--steel-1,#2b241a);border-radius:2px;padding:.5rem .6rem"><option>ymir</option></select>
            <input name="title" placeholder="plan title (6+)" required style="flex:2;background:var(--bg-1,#151209);color:var(--bone,#cfc3a9);border:1px solid var(--steel-1,#2b241a);border-radius:2px;padding:.5rem .6rem" />
          </div>
          <textarea name="body" rows="4" placeholder="the plan's body — anything plan-sized is written first (40+)" required style="background:var(--bg-1,#151209);color:var(--bone,#cfc3a9);border:1px solid var(--steel-1,#2b241a);border-radius:2px;padding:.5rem .6rem"></textarea>
          <div style="display:flex;gap:.6rem;align-items:center;flex-wrap:wrap">
            <select name="tickets" id="ticket-pick" multiple size="4" style="flex:1;background:var(--bg-1,#151209);color:var(--bone,#cfc3a9);border:1px solid var(--steel-1,#2b241a);border-radius:2px"></select>
            <button type="submit" style="background:transparent;color:var(--bronze,#c9973f);border:1px solid var(--bronze,#c9973f);border-radius:2px;padding:.5rem 1.1rem;cursor:pointer;font-family:var(--mono,monospace)">cut the plan</button>
          </div>
          <div class="msg" id="pmsg" hidden></div>
        </form>
      </div>
      <div id="card-list" style="display:grid;gap:.5rem;padding:.8rem"></div>
    </div>
  </div>
  <div class="hall-foot" style="margin-top:2rem">
    <div class="hall-foot-big">the plans ride the tickets — cut, approved, shipped</div>
    <div class="hall-foot-close">the approval is the Allfather's hand alone</div>
  </div>
</main>
<style>
  .td-act{background:transparent;color:var(--bronze,#c9973f);border:1px solid var(--bronze,#c9973f);border-radius:2px;padding:.4rem .9rem;cursor:pointer;font-family:var(--mono,monospace);font-size:.7rem}
  .td-act:hover{background:var(--bronze,#c9973f);color:var(--bg-0,#0e0c09)}
  .msg{white-space:pre-wrap;font-size:.8rem;font-family:var(--mono,monospace);padding:.5rem .6rem}
  .err{color:var(--danger,#c2584a);border:1px solid var(--danger,#c2584a)}
  .ok{color:var(--ok,#96a0a8);border:1px solid var(--ok,#96a0a8)}
</style>
<script>
const SKULD = "http://192.168.68.111:8320";
let sid = null, ROWS = [], FILTER_STATUS = "";
const POST = (body) => fetch(SKULD, { method: "POST", headers: { "content-type": "application/json", "accept": "application/json, text/event-stream", ...(sid ? { "mcp-session-id": sid } : {}) }, body: JSON.stringify(body) }).then(r => r.json());
async function init() { const h = await fetch(SKULD, { method: "POST", headers: { "content-type": "application/json", "accept": "application/json, text/event-stream" }, body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "initialize", params: { protocolVersion: "2025-06-18", capabilities: {}, clientInfo: { name: "brokk", version: "1" } } }) }); sid = h.headers.get("mcp-session-id") || ""; }
async function call(name, args) { const r = await fetch(SKULD, { method: "POST", headers: { "content-type": "application/json", "accept": "application/json, text/event-stream", ...(sid ? { "mcp-session-id": sid } : {}) }, body: JSON.stringify({ jsonrpc: "2.0", id: Date.now(), method: "tools/call", params: { name, arguments: args } }) }); const d = await r.json(); return (d.result?.content?.[0]?.text) || (d.error?.message) || "silence"; }
function esc(s){ const d = document.createElement("div"); d.textContent = s || ""; return d.innerHTML; }
const PCOLORS = { "drafted":"#6b7280", "active":"#96a0a8", "approved":"#eab308", "shipped":"#3b82f6", "done":"#22c55e", "superseded":"#f97316" };
function pill(st){ const c = PCOLORS[st] || "#6b7280"; return `<span style="display:inline-block;font-size:.66rem;padding:.14rem .55rem;border-radius:999px;background:${c}22;color:${c};border:1px solid ${c}">${esc(st)}</span>`; }
function render(){
  const rows = ROWS.filter(r => { const c = r.split("|"); return !FILTER_STATUS || c[2] === FILTER_STATUS; });
  const strip = { "awaiting": 0, "approved": 0, "shipped": 0, "done": 0 };
  ROWS.forEach(r => { const s = r.split("|")[2]; if (s === "drafted" || s === "active") strip.awaiting++; else if (s === "approved") strip.approved++; else if (s === "shipped") strip.shipped++; else if (s === "done" || s === "superseded") strip.done++; });
  document.getElementById("strip").innerHTML = Object.keys(strip).map(k => `<div style="background:var(--bg-2,#1a1610);border:1px solid var(--steel-1,#2b241a);border-radius:6px;padding:.55rem .8rem"><b style="display:block;font-size:1.35rem;color:var(--bone,#cfc3a9)">${strip[k]}</b><span style="font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--bone-dim,#9a8f75)">${k}</span></div>`).join("");
  document.getElementById("plan-count").textContent = rows.length;
  const list = document.getElementById("card-list");
  list.innerHTML = rows.map(r => { const [id, ns, st, tickets, title, frag] = r.split("|");
    return `<div class="pcard" data-id="${esc(id)}" style="display:flex;gap:.8rem;align-items:flex-start;background:var(--bg-2,#1a1610);border:1px solid var(--steel-1,#2b241a);border-left:3px solid ${PCOLORS[st]||"#6b7280"};border-radius:6px;padding:.65rem .85rem;cursor:pointer"><span class="mono dim" style="min-width:4.2rem">${esc(ns)}/${esc(id)}</span><div style="flex:1;min-width:0"><div style="color:var(--bone,#cfc3a9);font-size:.92rem">${esc(title)}</div><div style="color:var(--bone-dim,#9a8f75);font-size:.78rem;margin-top:.15rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(frag || "")}</div><div style="display:flex;gap:.45rem;margin-top:.25rem;flex-wrap:wrap">${pill(st)}<span class="mono dim" style="font-size:.62rem">rides: ${esc(tickets || "-")}</span></div></div></div>`; }).join("");
  document.querySelectorAll(".pcard").forEach(c => c.addEventListener("click", () => { location.href = "/plan?id=" + c.dataset.id; }));
}
async function load(){ const t = await call("plans_list", {}); ROWS = (t.split("\n")||[]).filter(Boolean); render(); }
async function fillPicks(){
  try { const raw = await call("namespaces_list", {}); const ns = document.getElementById("ns-pick"); if (ns) { const opts = (raw.split("\n")||[]).filter(Boolean); if (opts.length) { ns.innerHTML = ""; opts.forEach(o => { const [s,n] = o.split("|"); const opt = document.createElement("option"); opt.value = s; opt.textContent = s + (n && n !== s ? " — " + n : ""); ns.appendChild(opt); }); } } } catch(e) {}
  const t = await call("tickets_list", {}); const tp = document.getElementById("ticket-pick"); if (tp) { tp.innerHTML = ""; (t.split("\n")||[]).filter(Boolean).forEach(r => { const c = r.split("|"); const o = document.createElement("option"); o.value = c[0].replace(/^#/,""); o.textContent = c[2] + "/" + c[1] + "  " + c[5]; tp.appendChild(o); }); }
  const fs = document.getElementById("f-status"); fs.innerHTML = '<option value="">status: any</option>'; ROWS.forEach(r => { const s = r.split("|")[2]; if (s && !Array.from(fs.options).some(o => o.value === s)) { const o = document.createElement("option"); o.value = s; o.textContent = s; fs.appendChild(o); } });
}
window.addEventListener("DOMContentLoaded", async () => {
  await init(); await fillPicks(); load();
  document.getElementById("f-status").addEventListener("change", e => { FILTER_STATUS = e.target.value || ""; render(); });
  document.getElementById("new-plan-btn").addEventListener("click", () => { const p = document.getElementById("new-panel"); p.hidden = !p.hidden; });
  document.getElementById("pf").addEventListener("submit", async e => {
    e.preventDefault(); const f = new FormData(e.target);
    const r = await call("plans_create", { namespace: f.get("namespace"), title: f.get("title"), body: f.get("body"), tickets: Array.from(document.querySelectorAll("#ticket-pick option:checked")).map(o => parseInt(o.value, 10)) });
    const m = document.getElementById("pmsg"); m.hidden = false; m.className = "msg " + (/created/.test(r) ? "ok" : "err"); m.textContent = r;
    if (/created/.test(r)) { document.getElementById("new-panel").hidden = true; load(); }
  });
});
</script>
</body>
</html>