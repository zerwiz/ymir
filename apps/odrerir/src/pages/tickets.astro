---
// tickets.astro — Skuld, the hall's book — the wayofteams anatomy, faithful:
// a filterable, sortable TABLE with bulk power and a +New door; the press
// opens the ticket's detail with the stat-strip, the review march, the
// assignee's pick and the comments thread. Click-only, never typing.
import '../styles/cloth.css'
import '../styles/livehall.css'
const SKULD = "http://192.168.68.111:8320";
---
<html lang="en">
<head>
<meta charset="utf-8" />
<title>Skuld — the hall's book</title>
<meta name="viewport" content="width=device-width, initial-scale=1" />
</head>
<body>
<div class="hall-top">
  <span><span class="rn">ᛉ</span>YMIR · SKULD — THE HALL'S BOOK</span>
  <span class="hall-links" style="display:inline-flex;gap:1rem;align-items:center">
    <a class="hall-back" href="/" title="the live hall — the board">← the hall</a>
    <a class="hall-back" href="/plans" title="the plans — the roadmap">the plans →</a>
  </span>
</div>
<main class="hall-wrap" id="book">
  <header class="shead rv">
    <span class="snum rn" aria-hidden="true">ᛉ</span>
    <p class="skicker"><span class="rn">ᛉ</span>skuld · the debts owed</p>
    <h1 id="book-h2">The Hall's Book</h1>
    <p class="ssub">the tickets of the fleet — filter, sort, pick, press — the book answers the hand, never the keyboard</p>
  </header>

  <div class="panel rv">
    <div class="panel-head">
      <div class="panel-title"><span class="glyph" aria-hidden="true">ᛏ</span>the tickets <span id="tick-count" class="kb-count" style="margin-left:.4rem"></span></div>
      <button type="button" id="new-ticket-btn" class="td-act">+ new ticket</button>
    </div>
    <div class="panel-body flush">
      <div class="filters" id="filters">
        <select id="f-status"><option value="">status: any</option></select>
        <select id="f-priority"><option value="">priority: any</option><option>Low</option><option>Medium</option><option>High</option><option>Critical</option></select>
        <select id="f-assignee"><option value="">assignee: any</option></select>
      </div>
      <div id="new-panel" hidden style="padding:.7rem .9rem;border-bottom:1px solid var(--steel-1,#2b241a)">
        <form id="tf" class="book-form">
          <div class="book-row">
            <select name="namespace" id="ns-pick"><option>ymir</option></select>
            <select name="priority"><option>Low</option><option selected>Medium</option><option>High</option><option>Critical</option></select>
            <select name="status" id="new-status"><option>Backlog</option><option>Planned</option><option selected>Ready</option><option>In Progress</option><option>Submitted for Review</option><option>In Review</option><option>Approved</option><option>Done</option><option>Changes Requested</option></select>
          </div>
          <input name="title" placeholder="title" required />
          <textarea name="description" rows="3" placeholder="description — the deed in the fleet's words" required></textarea>
          <div class="book-row">
            <div id="label-chips" class="chips" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:center"><span class="mono dim" style="font-size:.68rem">labels:</span></div>
            <button type="submit">cut the ticket</button>
          </div>
          <div class="msg" id="tmsg" hidden></div>
        </form>
      </div>
      <div class="bulk" id="bulk" style="display:flex;align-items:center;gap:.7rem;padding:.5rem .9rem;border-bottom:1px solid var(--steel-1,#2b241a)">
        <span class="mono dim" style="font-size:.7rem" id="sel-count">none selected</span>
        <select id="bulk-status" style="background:var(--bg-1,#151209);color:var(--bone,#cfc3a9);border:1px solid var(--steel-1,#2b241a);border-radius:2px;padding:.3rem .5rem;font-size:.72rem">
          <option value="">change status…</option>
          <option>Backlog</option><option>Planned</option><option>Ready</option><option>In Progress</option><option>Submitted for Review</option><option>In Review</option><option>Approved</option><option>Done</option><option>Changes Requested</option>
        </select>
        <button type="button" id="bulk-go" class="td-act">apply</button>
      </div>
      <table class="tick-table" id="tick-table">
        <thead><tr>
          <th style="width:2rem"><input type="checkbox" id="sel-all" /></th>
          <th>ID</th><th>title</th><th>status</th><th>pri</th><th>who</th><th>⇡</th>
        </tr></thead>
        <tbody id="tick-body"><tr><td colspan="7" class="dim">reading the book…</td></tr></tbody>
      </table>
    </div>
  </div>

  <div class="hall-foot">
    <div class="hall-foot-big">one book, two doors — the MCP and the hall</div>
    <div class="hall-foot-close">press any ticket to open it — the review march, the assignments, the thread</div>
  </div>
</main>
<style>
  .filters{display:flex;gap:.6rem;flex-wrap:wrap;padding:.6rem .9rem;border-bottom:1px solid var(--steel-1,#2b241a)}
  .filters select{background:var(--bg-1,#151209);color:var(--bone,#cfc3a9);border:1px solid var(--steel-1,#2b241a);border-radius:2px;padding:.35rem .6rem;font-size:.74rem}
  .tick-table{width:100%;border-collapse:collapse;font-size:.84rem}
  .tick-table th{text-align:left;padding:.5rem .7rem;color:var(--bone-dim,#9a8f75);letter-spacing:.08em;font-weight:400;text-transform:lowercase;border-bottom:1px solid var(--steel-1,#2b241a);font-size:.7rem}
  .tick-table td{padding:.5rem .7rem;border-bottom:1px solid var(--steel-1,#2b241a)}
  .tick-table tbody tr{cursor:pointer}
  .tick-table tbody tr:hover{background:var(--bg-2,#1a1610)}
  .st-badge{display:inline-block;font-size:.68rem;padding:.14rem .5rem;border-radius:999px;font-family:var(--mono,monospace)}
  .book-form{display:grid;gap:.6rem}
  .book-row{display:flex;gap:.6rem;flex-wrap:wrap}
  .book-form input,.book-form select,.book-form textarea{background:var(--bg-1,#151209);color:var(--bone,#cfc3a9);border:1px solid var(--steel-1,#2b241a);border-radius:2px;padding:.5rem .6rem;font:inherit}
  .book-form button{background:transparent;color:var(--bronze,#c9973f);border:1px solid var(--bronze,#c9973f);border-radius:2px;padding:.5rem 1.1rem;cursor:pointer;letter-spacing:.12em;font-family:var(--mono,monospace)}
  .book-form button:hover{background:var(--bronze,#c9973f);color:var(--bg-0,#0e0c09)}
  .td-act{background:transparent;color:var(--bronze,#c9973f);border:1px solid var(--bronze,#c9973f);border-radius:2px;padding:.4rem .9rem;cursor:pointer;font-family:var(--mono,monospace);font-size:.7rem;letter-spacing:.08em}
  .td-act:hover{background:var(--bronze,#c9973f);color:var(--bg-0,#0e0c09)}
  .chip{background:transparent;color:var(--bone-dim,#9a8f75);border:1px solid var(--steel-1,#2b241a);border-radius:999px;font-family:var(--mono,monospace);font-size:.66rem;padding:.26rem .65rem;cursor:pointer}
  .chip.on{background:var(--bronze,#c9973f);color:var(--bg-0,#0e0c09);border-color:var(--bronze,#c9973f)}
  .msg{white-space:pre-wrap;font-size:.8rem;font-family:var(--mono,monospace);padding:.5rem .6rem}
  .err{color:var(--danger,#c2584a);border:1px solid var(--danger,#c2584a)}
  .ok{color:var(--ok,#96a0a8);border:1px solid var(--ok,#96a0a8)}
  .ticket-detail{position:fixed;inset:0;z-index:60}
  .td-backdrop{position:absolute;inset:0;background:rgba(8,7,5,.74)}
  .td-panel{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(560px,92vw);max-height:86vh;overflow:auto;background:var(--bg-1,#151209);border:1px solid var(--bronze-deep,#7d5f2a);border-radius:6px;box-shadow:0 18px 60px rgba(0,0,0,.5);padding:1.2rem 1.4rem}
  .td-strip{display:grid;grid-template-columns:repeat(5,1fr);gap:.5rem;margin-bottom:1rem}
  .td-strip>div{background:var(--bg-2,#1a1610);border:1px solid var(--steel-1,#2b241a);border-radius:4px;padding:.45rem .6rem;text-align:center}
  .td-strip b{display:block;font-size:1.1rem;color:var(--bone,#cfc3a9)}
  .td-strip span{font-size:.6rem;letter-spacing:.12em;text-transform:lowercase;color:var(--bone-dim,#9a8f75)}
  .td-panel h2{font-family:var(--serif,Georgia);font-size:1.15rem;color:var(--bone,#cfc3a9);margin:.5rem 0 .4rem}
  .td-desc{font-size:.85rem;line-height:1.5;color:var(--bone-dim,#9a8f75);margin:0 0 .8rem;white-space:pre-wrap}
  .td-row{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin-bottom:.8rem}
  .td-actions{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:.8rem}
  .td-comments{display:grid;gap:.5rem;margin-top:.5rem}
  .td-comment{background:var(--bg-2,#1a1610);border:1px solid var(--steel-1,#2b241a);border-radius:4px;padding:.5rem .7rem;font-size:.78rem}
  .td-comment .a{font-family:var(--mono,monospace);font-size:.62rem;color:var(--bronze,#c9973f)}
  .td-close{background:transparent;color:var(--bone-dim,#9a8f75);border:none;font-size:1rem;cursor:pointer;margin-left:auto}
  @media(max-width:700px){.td-strip{grid-template-columns:repeat(3,1fr)}}
</style>
<script>
const SKULD = "http://192.168.68.111:8320";
let sid = null;
const POST = (body) => fetch(SKULD, { method: "POST", headers: { "content-type": "application/json", "accept": "application/json, text/event-stream", ...(sid ? { "mcp-session-id": sid } : {}) }, body: JSON.stringify(body) }).then(r => r.json());
async function init() {
  const h = await fetch(SKULD, { method: "POST", headers: { "content-type": "application/json", "accept": "application/json, text/event-stream" }, body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "initialize", params: { protocolVersion: "2025-06-18", capabilities: {}, clientInfo: { name: "odrerir-hall", version: "1" } } }) });
  sid = h.headers.get("mcp-session-id") || "";
}
const call = (name, args) => POST({ jsonrpc: "2.0", id: Date.now(), method: "tools/call", params: { name, arguments: args } }).then(d => (d.result?.content?.[0]?.text) || (d.error?.message) || "silence");
function esc(s){ const d=document.createElement("div"); d.textContent=s||""; return d.innerHTML; }
const COLORS = { "Backlog":"#6B7280", "Planned":"#7d5f2a", "Ready":"#96a0a8", "In Progress":"#3B82F6", "Submitted for Review":"#EAB308", "In Review":"#EAB308", "Approved":"#22C55E", "Done":"#22C55E", "Changes Requested":"#F97316" };
const MARCH = { "Backlog":["Planned"], "Planned":["Ready"], "Ready":["In Progress"], "In Progress":["Submitted for Review","Changes Requested"], "Submitted for Review":["In Review"], "In Review":["Approved","Changes Requested"], "Approved":["Done"], "Done":[], "Changes Requested":["In Progress"] };
let ROWS = []; let sel = new Set();
function stBadge(st){ return `<span class="st-badge" style="background:${COLORS[st]||"#c9973f"}22;color:${COLORS[st]||"#c9973f"};border:1px solid ${COLORS[st]||"#c9973f"}">${esc(st)}</span>`; }
function fillFilters(){
  const fs = document.getElementById("f-status"), fa = document.getElementById("f-assignee");
  fs.innerHTML = '<option value="">status: any</option>';
  fa.innerHTML = '<option value="">assignee: any</option>';
  const statuses = {}, assignees = {};
  ROWS.forEach(r => { const [rawId,no,ns,st,pr,title,who,par] = r.split("|"); const id = (rawId||"").replace(/^#/,""); statuses[st] = 1; if (who) assignees[who] = 1; });
  Object.keys(statuses).forEach(s => { const o = document.createElement("option"); o.value = s; o.textContent = s; fs.appendChild(o); });
  Object.keys(assignees).forEach(a => { const o = document.createElement("option"); o.value = a; o.textContent = a; fa.appendChild(o); });
  document.getElementById("new-status").value = "Ready";
}
function renderRows(){
  const fs = document.getElementById("f-status").value, fp = document.getElementById("f-priority").value, fa = document.getElementById("f-assignee").value;
  const rows = ROWS.filter(r => { const c = r.split("|"); return (!fs || c[3] === fs) && (!fp || c[4] === fp) && (!fa || c[6] === fa); });
  document.getElementById("tick-count").textContent = rows.length;
  document.getElementById("tick-body").innerHTML = rows.map(r => { const [rawId,no,ns,st,pr,title,who,par] = r.split("|"); const id = (rawId||"").replace(/^#/,"");
    return `<tr data-id="${esc(id)}"><td><input type="checkbox" class="row-sel" value="${esc(id)}" ${sel.has(id) ? "checked" : ""} /></td><td class="mono dim">${esc(ns)}/${esc(no)}</td><td>${esc(title)}</td><td>${stBadge(st)}</td><td>${esc(pr)}</td><td class="dim">${esc(who||"")}</td><td class="dim">${par && par !== "0" ? "⇡" + esc(par) : ""}</td></tr>`;
  }).join("");
  document.querySelectorAll("#tick-body tr").forEach(tr => tr.addEventListener("click", function(e){
    if (e.target.closest("input")) return; const id = Number(tr.dataset.id); openTicket(id);
  }));
  document.querySelectorAll(".row-sel").forEach(cb => cb.addEventListener("change", function(){ this.checked ? sel.add(this.value) : sel.delete(this.value); selCount(); }));
  document.getElementById("sel-all").checked = rows.length > 0 && rows.every(r => sel.has(r.split("|")[0]));
}
function selCount(){ document.getElementById("sel-count").textContent = sel.size ? sel.size + " selected" : "none selected"; }
async function loadBook(){
  const t = await call("tickets/list", { namespace: "ymir" });
  ROWS = (t.split("\n")||[]).filter(Boolean);
  fillFilters(); renderRows();
}
async function openTicket(id){
  const old = document.getElementById("ticket-detail"); if (old) old.remove();
  const raw = await call("tickets/get", { id: Number(id) || 0 });
  const c = raw.split("|");
  const [tid, tno, ns, title, desc, pri, st, labels, who, assignee] = c;
  const all = ROWS.map(r => r.split("|"));
  const strip = { "Backlog":0, Active:0, Review:0, Blocked:0, Done:0 };
  all.forEach(x => { const s = x[3]; if (s === "Backlog" || s === "Planned" || s === "Ready") strip.Backlog++; else if (s === "In Progress") strip.Active++; else if (s === "Submitted for Review" || s === "In Review") strip.Review++; else if (s === "Changes Requested") strip.Blocked++; else if (s === "Done") strip.Done++; });
  const comments = await call("comments/list", { id });
  const o = document.createElement("div"); o.id = "ticket-detail"; o.className = "ticket-detail";
  o.innerHTML = `<div class="td-backdrop" onclick="document.querySelector('#ticket-detail')&&document.querySelector('#ticket-detail').remove()"></div>
<div class="td-panel">
  <div class="td-head" style="display:flex;align-items:center"><span class="mono dim">${esc(ns)}/${esc(tno)} · ${esc(st)}</span><button type="button" class="td-close" id="td-x">✕</button></div>
  <div class="td-strip">
    <div><b>${strip.Backlog}</b><span>Backlog</span></div><div><b>${strip.Active}</b><span>Active</span></div><div><b>${strip.Review}</b><span>Review</span></div><div><b>${strip.Blocked}</b><span>Changes</span></div><div><b>${strip.Done}</b><span>Done</span></div>
  </div>
  <h2>${esc(title || ('raw: ' + raw.slice(0, 90)))}</h2>
  <p class="td-desc">${esc(desc||"")}</p>
  <div class="td-row">
    <span class="p-chip mono dim">${esc(pri)}</span>
    <span class="mono dim">holder:</span><select id="td-assign">${all.filter(x=>x[3]!=="Done").map(x=>'<option value="'+esc(x[6]||"hall")+'">'+esc(x[6]||"hall")+'</option>').join("")}</select>
    ${labels && labels !== "{}" ? `<span class="mono dim">labels: ${esc(String(labels).replace(/[{}"']/g,""))}</span>` : ""}
  </div>
  <div class="td-actions">${(MARCH[st]||[]).map(s => `<button type="button" class="td-act td-march" data-to="${esc(s)}">→ ${esc(s)}</button>`).join("") || `<span class="mono dim">terminal — ${esc(st)}</span>`}</div>
  <div class="td-comments" id="td-comments">${(comments.split("\n")||[]).filter(Boolean).map(x => { const p = x.split("|"); return `<div class="td-comment"><span class="a">${esc(p[1])} · ${esc(p[3])}</span><div>${esc(p[2])}</div></div>`; }).join("") || `<div class="mono dim" style="font-size:.7rem">no comments yet</div>`}</div>
  <div class="book-form" style="margin-top:.7rem"><div class="book-row"><input id="td-comment-text" placeholder="a word on this ticket" /><button type="button" id="td-comment-btn" class="td-act">carve</button></div></div>
</div>`;
  document.body.appendChild(o);
  document.getElementById("td-x").addEventListener("click", () => o.remove());
  document.getElementById("td-assign").addEventListener("change", async function(){ const r = await call("tickets/update", { id, assignee: this.value }); });
  document.querySelectorAll(".td-march").forEach(b => b.addEventListener("click", async () => { const to = b.dataset.to; const r = await call("tickets/update", { id, status: to }); if (/updated/.test(r)) { o.remove(); loadBook(); } }));
  document.getElementById("td-comment-btn").addEventListener("click", async () => { const v = document.getElementById("td-comment-text").value.trim(); if (!v) return; const r = await call("comments/post", { id, body: v }); if (/carved/.test(r)) o.remove(); });
}
window.addEventListener("DOMContentLoaded", async () => {
  await init(); loadBook();
  ["f-status","f-priority","f-assignee"].forEach(id => document.getElementById(id).addEventListener("change", renderRows));
  document.getElementById("sel-all").addEventListener("change", function(){
    const vis = Array.from(document.querySelectorAll(".row-sel"));
    vis.forEach(cb => { cb.checked = this.checked; this.checked ? sel.add(cb.value) : sel.delete(cb.value); }); selCount();
  });
  document.getElementById("bulk-go").addEventListener("click", async () => {
    const to = document.getElementById("bulk-status").value; if (!to || !sel.size) return;
    for (const id of Array.from(sel)) await call("tickets/update", { id: parseInt(id,10), status: to });
    sel.clear(); selCount(); loadBook();
  });
  document.getElementById("new-ticket-btn").addEventListener("click", function(){ const p = document.getElementById("new-panel"); p.hidden = !p.hidden; });
  const labelChips = ["fleet","infra","ui","api","release","vault","review","craft"];
  const wrap = document.getElementById("label-chips");
  labelChips.forEach(l => { const b = document.createElement("button"); b.type="button"; b.className="chip"; b.dataset.l=l; b.textContent=l; b.addEventListener("click", function(){ this.classList.toggle("on"); }); wrap.appendChild(b); });
  document.getElementById("tf").addEventListener("submit", async e => {
    e.preventDefault(); const f = new FormData(e.target);
    const r = await call("tickets/create", { namespace: f.get("namespace"), title: f.get("title"), description: f.get("description"), priority: f.get("priority"), status: f.get("status"), labels: Array.from(document.querySelectorAll("#label-chips .chip.on")).map(b => b.dataset.l) });
    const m = document.getElementById("tmsg"); m.hidden=false; m.className="msg "+(/created/.test(r)?"ok":"err"); m.textContent=r;
    if (/created/.test(r)) { loadBook(); document.getElementById("new-panel").hidden = true; }
  });
});
</script>
</body>
</html>