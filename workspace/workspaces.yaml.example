# Workspace registry — the SHAPE only. The real registry lives in the Hoard:
#   hodd/identity/workspaces.yaml   (private; see RULES/04-hoard.md)
workspaces:
  - id: work
    name: Work
    kind: work
    company: wayof
    domains: [company, marketing, development, life]
  - id: personal
    name: Personal
    kind: personal
    domains: [me, life, development]
