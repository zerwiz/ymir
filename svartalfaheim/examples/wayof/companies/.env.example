# A venture's own secrets — template
#
# Copy this to `.env` beside it when a company must not share the realm's
# credentials (its own Stripe account, its own database, its own mail domain):
#
#   cp companies/.env.example companies/<company>/.env
#
# The real `.env` is git-ignored; this template is the tracked copy. Delete the
# sections this venture does not use — an empty value is honest, a plausible
# placeholder is not. Full rule: ../../SECRETS.md

# Which company this file belongs to (its slug under companies/).
COMPANY_NAME=
COMPANY_DOMAIN=

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Data ──────────────────────────────────────────────────────────────────────
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Mail / comms ──────────────────────────────────────────────────────────────
SMTP_URL=
DISCORD_WEBHOOK_URL=

# ── Deploy ────────────────────────────────────────────────────────────────────
VERCEL_TOKEN=
