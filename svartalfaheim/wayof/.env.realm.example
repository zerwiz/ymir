# WayOf — company environment template
#
# HOW TO USE THIS FILE
#   1. cp .env.realm.example .env.realm
#   2. fill in only what this company actually uses — an empty value is honest,
#      an invented one is not
#   3. never commit .env.realm. It is git-ignored (`.gitignore`: `svartalfaheim/*/.env*`);
#      this template is the only tracked copy. See SECRETS.md for the full rule.
#
# WHERE IT IS READ
#   bin/saga-session-start.sh, bin/nornir-job-*.sh, bin/workspace-rag.sh and the
#   Hlidskjalf gate load `svartalfaheim/<realm>/.env.realm` for the active realm
#   (default realm: `wayof`). Nothing else reads it, and nothing prints it.

# ── Realm identity ────────────────────────────────────────────────────────────
# Who this environment belongs to. Set these first; the tools report them.
REALM_NAME=wayof
REALM_OWNER=
REALM_TYPE=company

# ── Runtime switches ──────────────────────────────────────────────────────────
MODEL_BRIDGE_ENABLED=0
SUPERVISION_ARMED=0
LOG_LEVEL=info
DEBUG_MODE=0

# ── Backend / database ────────────────────────────────────────────────────────
# Supabase: Project settings → API. The service key is server-only, never client.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Firebase: console → Project settings → Service accounts (JSON) for the token.
FIREBASE_PROJECT_ID=
FIREBASE_TOKEN=

# ── Payments ──────────────────────────────────────────────────────────────────
# Stripe: Dashboard → Developers → API keys / Webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Deploy & source ───────────────────────────────────────────────────────────
# Vercel: Account settings → Tokens.
VERCEL_TOKEN=
# GitHub: prefer the operator's own `gh auth login`; a token here is a fallback
# and must carry the narrowest scopes that work (repo, read:org).
GITHUB_TOKEN=

# ── Communications ────────────────────────────────────────────────────────────
# Discord: Server settings → Integrations → Webhooks.
DISCORD_WEBHOOK_URL=

# ── Models / agents (optional) ────────────────────────────────────────────────
# Only if this company bills its own inference rather than using the operator's
# local backends (see .agents/skills/galdr-cli/assets/local-models.md).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Per-company values ────────────────────────────────────────────────────────
# A company with its own accounts, or a venture that must not share credentials
# with the rest, keeps them in its own file:
#
#   svartalfaheim/wayof/companies/<company>/.env
#   svartalfaheim/wayof/companies/<company>/.env.example   ← tracked template
#
# Same rules: the real file is ignored, the template is committed, and a secret
# never lands in an entity card, a log, or a rune.
