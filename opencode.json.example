{
  "$schema": "https://opencode.ai/config.json",
  "model": "",
  "default_agent": "brokk",
  "agent": {
    "brokk": {
      "description": "Primary autonomous agent of the Ymir Agent Operating System",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "temperature": 0.7,
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "task": "allow",
        "skill": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "external_directory": "allow"
      }
    },
    "build": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "Implementation subagent for Ymir forge orders",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "skill": "allow"
      }
    },
    "builder": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "Builder \u2014 implement the plan exactly; report every changed file.",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "skill": "allow"
      }
    },
    "plan": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "Planning subagent for Ymir architecture",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "skill": "allow"
      }
    },
    "planner": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "Planner \u2014 turn a request into a plan the builder can implement without asking questions.",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "skill": "allow"
      }
    },
    "reviewer": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "Reviewer \u2014 confirm what was built is what was asked for; change nothing.",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "skill": "allow"
      }
    },
    "documenter": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "Documenter \u2014 write up the change from the diff; document only.",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "skill": "allow"
      }
    },
    "scout": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "Scout \u2014 find and report where things live, change nothing.",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "skill": "allow"
      }
    },
    "hnoss": {
      "mode": "primary",
      "model": "llama.cpp/frontend-design-expert-8b@q4_k_m",
      "description": "hnoss \u2014 primary (from config/agents.yaml)"
    }
  },
  "skills": {
    "paths": [
      ".agents/skills"
    ]
  },
  "mcp": {
    "engram": {
      "type": "local",
      "command": [
        "__YMIR_HOME__/.local/bin/engram-mcp",
        "--db",
        "__YMIR_ROOT__/.agents/memory/kaia.engram"
      ],
      "enabled": true
    }
  },
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "frontend-design-expert-8b@q4_k_m": {
          "name": "frontend-design-expert-8b@q4_k_m"
        }
      }
    }
  },
  "lsp": false
}
