# .ymir-layout.yaml.example — the ymir-home layout map, taught PUBLIC.
#
# Every new ymir seat raises its private home from this skeleton. Copy it to
# $YMIR_HOME/.ymir-layout.yaml and point each key at the REAL directory —
# the placement ward (bin/agents/eir-doctor.sh, "hoard" surface) validates that every
# mapped path EXISTS; a stale map is how private work lands outside the well.
#
# THE LAW OF THIS EXAMPLE: it mirrors the home's true map by NAME, one shelf
# to one key, but rides ZERO private values, ZERO seat literals, ZERO secrets.
# `$YMIR_HOME` below is the ONLY literal the fleet is allowed to teach — it is
# the path the seat resolves (default ~/Documents/ymirhome, the private repo
# $YMIR_HOME_REPO — the seat-held remote, taught as FORM only; never name the real one.
#
# Names mirror the home 1:1 (each key BELOW must name a directory that EXISTS
# once you raise it). The real home's map — the placement-ward's validation
# target — sits at your private $YMIR_HOME/.ymir-layout.yaml, not here.
#
# ── version 2 (plan 331, 2026-11-19): THE FOUR SHELVES ──────────────────────────
#
#   hodd/    the RECORD — memory, identity, plans, secrets, reference, docs.
#            never: runtime artefacts, the operator's own material, build output.
#   life/    the OPERATOR'S OWN MATERIAL — personal, work, marketing, meetings, outreach.
#            never: the house's ledger, a secret, runtime state.
#   state/   RUNTIME STATE written by supervisors — leases, queues, rooms, counters.
#            never: anything append-only (the well, the ledger), anything another machine must read.
#   config/  SETTINGS, per machine and per person.
#            never: a secret value (a setting references hodd/secrets/), a record.
#
# There is no `hodd/life`, no `hodd/state` and no `hodd/workspaces/` in this shape. A home made before
# version 2 is moved by .agents/migrations/0026-life-and-state-out-of-hodd.sh, which leaves the links
# `hodd/life -> ../life` and `hodd/state -> ../state` for ONE release cycle (plan 331.7) — those two
# links are the compatibility shim, never a shelf. The master register that names every register in
# the home is hodd/identity/home.yaml (template: hodd/identity/home.yaml.example).
version: 2
layout:
  record: "$YMIR_HOME/hodd"                 # the record (the hoard)
  life: "$YMIR_HOME/life"                   # the operator's own material
  state: "$YMIR_HOME/state"                 # runtime state; stale-* drop storage
  config: "$YMIR_HOME/config"               # settings
  secrets: "$YMIR_HOME/hodd/secrets"        # encrypted at rest, by path only
  identity: "$YMIR_HOME/hodd/identity"      # the registers; home.yaml names them all
  memory: "$YMIR_HOME/hodd/memory"          # the ONE well — append-only, never moved
  data: "$YMIR_HOME/hodd/data"
  smidja: "$YMIR_HOME/smidja"               # runtime only (ephemeral)
  svartalfaheim: "$YMIR_HOME/svartalfaheim" # realms — the company shelves
git_repo: "$YMIR_HOME"
github_repo: "<owner>/<private-home-repo>"  # the private home well (never public) — FORM only, never the real name
secrets_encrypted: false
