mill-worker.service:daemon-in-bash   # the queue worker should be a Python daemon
mimir.service:service-in-shim        # the unit's door is 126 lines; give the unit a thin exec of an engram-compatible python
bifrost.service:service-in-shim      # bin/bifrost-bridge.sh (140 lines) only execs python; move the logic into Python and exec it directly
