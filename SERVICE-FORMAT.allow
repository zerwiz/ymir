# Service-format debt, DECLARED. One `unit:rule  # reason` per line.
# A declaration is a decision, and it can be reviewed. New findings are NOT
# allowed: bin/service-format.sh fails on anything not named here, so the debt
# can be paid down (plan 58 Phase 5's companion) but cannot grow.
#
# Rules: daemon-in-bash · oneshot-loop · service-in-shim.
nornir.service:oneshot-loop          # the scheduler loop should be a Python service (Type=simple), or systemd timers
mill-worker.service:daemon-in-bash   # the queue worker should be a Python daemon
mimir.service:service-in-shim        # bin/mimir-bridge.sh (126 lines) only execs python; move the logic into Python and exec it directly
bifrost.service:service-in-shim      # bin/bifrost-bridge.sh (140 lines) only execs python; move the logic into Python and exec it directly
