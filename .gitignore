# Mimirsbrunn — the well is PER-MACHINE, never shared.
# It is "one repo-local store shared by every agent" on THIS machine, not between
# machines/users: a clone must never inherit another user's memory, and the
# SQLite -wal/-shm sidecars are volatile runtime files that must never be
# versioned (a stale WAL can corrupt a fresh clone's store).
# The append log under memory/well/ is the same class of data. Only the
# README (the contract) is tracked; the store is rebuilt per machine.
.agents/memory/kaia.engram*
.agents/memory/*.db
.agents/memory/well/*.jsonl

# smidja runtime
smidja/smidja_data/sessions/
smidja/smidja_data/smidja.db*
.env
__pycache__/
*.pyc

# Capacitor / Android build artifacts
apps/hlidskjalf/android/app/build/
apps/hlidskjalf/android/build/
apps/hlidskjalf/android/.gradle/
apps/hlidskjalf/android/local.properties

# Large generated mobile artifact (build it — see README)
apps/hlidskjalf/public/ymir.apk

# Android release signing (never commit)
apps/hlidskjalf/android/ymir-release.keystore
apps/hlidskjalf/android/keystore.properties

# Per-user Ró preference (moved to state/; never tracked)
.agents/config/ro
# The Allfather's personal agent/harness/model setup — private, from the
# tracked template .agents/config/agents.yaml.example. Push it to a private repo.
.agents/config/agents.yaml
