        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "skill": "allow"
      }
    },
    "planner": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
