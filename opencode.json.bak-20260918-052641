      "model": "opencode-go/deepseek-v4.1-flash",
      "temperature": 0.7,
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "task": "allow",
        "skill": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "external_directory": "allow"
      }
    },
    "build": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "Implementation subagent for Ymir forge orders",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "skill": "allow"
      }
    },
    "builder": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "Builder \u2014 implement the plan exactly; report every changed file.",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "skill": "allow"
      }
    },
    "plan": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "Planning subagent for Ymir architecture",
