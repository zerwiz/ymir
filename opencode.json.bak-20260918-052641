        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "skill": "allow"
      }
    },
    "documenter": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "Documenter \u2014 write up the change from the diff; document only.",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "write": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "skill": "allow"
      }
    },
    "scout": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "Scout \u2014 find and report where things live, change nothing.",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "skill": "allow"
      }
    },
    "hnoss": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "hnoss \u2014 primary (from config/agents.yaml)"
    },
    "sindri": {
      "mode": "primary",
      "model": "qwen3-coder-30b/Qwen3-Coder-30B-A3B-Instruct-Q8_0.gguf",
