[Unit]
Description=Embedding stone — nomic qwen-scale embeddings (:8500)

[Service]
Type=simple
ExecStart=/usr/local/bin/llama-server -m $HOME_SEAT/Models/embed/nomic-embed-text-v1.5.Q4_K_M.gguf --embedding --port 8500 --alias embed --ctx-size 8192
