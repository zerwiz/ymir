[Unit]
Description=Skills MCP — the served skills well (:8319/mcp)
[Service]
Type=simple
Environment=PATH=%h/.bun/bin:/usr/bin:/bin
Environment=SKILLS_DIR=%h/.fleet/skills
ExecStart=%h/.fleet/well-venv/bin/mcp-proxy --host 0.0.0.0 --port 8319 -- node %h/.fleet/skills-mcp-server.mjs
Restart=on-failure
RestartSec=3
[Install]