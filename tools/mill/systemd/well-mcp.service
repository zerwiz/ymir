[Unit]
Description=Well MCP — served MCP face of the well (:8317/mcp)

[Service]
Type=simple
ExecStart=$HOME_SEAT/.venvs/well/bin/mcp-proxy --host 0.0.0.0 --port 8317 -- $HOME_SEAT/.venvs/well/bin/engram-mcp --db $HOME_SEAT/Documents/ymirhome/hodd/memory/kaia.engram
