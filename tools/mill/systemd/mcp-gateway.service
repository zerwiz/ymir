[Unit]
Description=MCP gateway — the body's one record door (:8316), proxying the heart and degrading to the local cache + journal when it is dark

[Service]
Type=simple
Environment=PATH=%h/.bun/bin:/usr/bin:/bin
Environment=MCP_GATEWAY_STATE=__YMIR_OPERATOR_STATE__
ExecStart=/bin/bash __YMIR_BIN_DIR__/bridge/mcp-gateway.sh serve
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=10

[Install]
WantedBy=ymir.target
