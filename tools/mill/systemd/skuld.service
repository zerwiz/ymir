[Unit]
Description=Skuld — the ticket hall (:8320, direct HTTP, no proxy)
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
Environment=PATH=%h/.bun/bin:/usr/bin:/bin:%h/.local/share/mise/shims:%h/.mise/shims
Environment=PORT=8320
# The database password is the operator's, set in ~/.config/ymir/fleet.env (SKULD_PGPASSWORD); none ships here.
# Loopback unless the operator widens it in ~/.config/ymir/fleet.env (2026-11-12).
Environment=YMIR_FLEET_BIND=127.0.0.1
EnvironmentFile=-%h/.config/ymir/fleet.env
ExecStart=node %h/.fleet/tickets-mcp-server.mjs
Restart=on-failure
RestartSec=3
[Install]
WantedBy=ymir.target