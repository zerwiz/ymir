[Unit]
Description=Skuld — the ticket hall (:8320/mcp)
[Service]
Type=simple
Environment=PATH=%h/.bun/bin:/usr/bin:/bin
Environment=SKULD_PGPASSWORD=skuld
ExecStart=%h/.fleet/well-venv/bin/mcp-proxy --host 0.0.0.0 --port 8320 -- node %h/.fleet/tickets-mcp-server.mjs
Restart=on-failure
RestartSec=3
[Install]