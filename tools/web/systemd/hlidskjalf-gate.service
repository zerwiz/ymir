[Unit]
Description=Hlidskjalf gate API — the live data face (:3889, dev seats)
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=__YMIR_APP_DIR__
# The house's tools live where the machine put them, not only in /usr/bin: `gh` here is
# a mise shim, and a unit whose PATH stops at /bin cannot find it — the digest then said
# "gh is not installed" while `gh --version` answered in every shell (plan 275 item 26).
# The shims go LAST so a system binary always wins and only a missing tool is resolved
# through mise. `units.sh check` reads these lines; the test that guards it is
# bin/engine/tests/test_unit_path_shims.sh.
Environment=PATH=%h/.bun/bin:/usr/bin:/bin:%h/.local/share/mise/shims:%h/.mise/shims
Environment=PORT=__YMIR_HLIDSKJALF_API_PORT__
# The operator's settings and secrets live in the hoard, never in the tree
# (Rule 04). A missing file is fine (the dash is systemd's "optional" mark) —
# the gate falls back to demo mode, honestly.
EnvironmentFile=-__YMIR_ENV_FILE__
ExecStart=%h/.bun/bin/bun run server/index.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=ymir.target