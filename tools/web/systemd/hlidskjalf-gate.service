[Unit]
Description=Hlidskjalf gate API — the live data face (:3889, dev seats)

[Service]
Type=simple
WorkingDirectory=__YMIR_APP_DIR__
Environment=PATH=%h/.bun/bin:/usr/bin:/bin
Environment=PORT=__YMIR_HLIDSKJALF_API_PORT__
# The operator's settings and secrets live in the hoard, never in the tree
# (Rule 04). A missing file is fine (the dash is systemd's "optional" mark) —
# the gate falls back to demo mode, honestly.
EnvironmentFile=-__YMIR_ENV_FILE__
ExecStart=%h/.bun/bin/bun run server/index.ts
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=120
StartLimitBurst=10

[Install]
WantedBy=ymir.target