{
  "name": "@zerwiz/ymir",
  "version": "0.2.1",
  "description": "Self-hosted multi-agent AI runtime for coding agents (Claude Code, Codex, OpenCode, pi, Hermes): isolated git-worktree workers, sandboxes, persistent memory, MCP and A2A — on your own machines, offline-first. Ymir — the single-tenant agent operating system. A fleet of machines (heart · forge · dev) over one record. One command: curl -fsSL https://raw.githubusercontent.com/zerwiz/ymir/main/install.sh | bash  ·  or: npx @zerwiz/ymir  ·  or: npm i -g @zerwiz/ymir. Offline-first (works with no server, syncs up after), MCP servers (memory · tickets · skills), role-gated crons, one delivery gate. If `ymir` is not found, the README has the three-line PATH cure.",
  "license": "Apache-2.0",
  "homepage": "https://ymir.zerwiz.org/how-to/",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerwiz/ymir.git"
  },
  "bugs": {
    "url": "https://github.com/zerwiz/ymir/issues"
  },
  "keywords": [
    "ymir",
    "ai-agent",
    "ai-agents",
    "coding-agent",
    "agentic",
    "multi-agent",
    "agent-orchestration",
    "autonomous-agents",
    "llm",
    "ai",
    "claude-code",
    "claude",
    "codex",
    "opencode",
    "cursor",
    "hermes",
    "hermes-agent",
    "ollama",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "a2a",
    "git-worktree",
    "sandbox",
    "local-llm",
    "llama.cpp",
    "self-hosted",
    "offline-first",
    "multi-machine",
    "agent-os",
    "cli",
    "devtools"
  ],
  "bin": {
    "ymir": "bin/engine/ymir.js",
    "ymir-install": "bin/engine/ymir-install.sh"
  },
  "files": [
    "bin/",
    "src/",
    ".agents/",
    "scripts/",
    "RULES/",
    "config/",
    "midgard/design-system/",
    "docs/",
    "packaging/",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    ".pi/",
    ".opencode/",
    ".claude/",
    ".codex/",
    ".cursor/",
    "assets/",
    "data/",
    "deploy/",
    "apps/",
    "install.sh",
    "tools/",
    "packages/",
    "systems/",
    "registry/",
    "hodd/",
    "svartalfaheim/",
    "FEATURES.md",
    "!**/node_modules/**",
    "!.agents/memory/kaia.engram*",
    "!.agents/memory/well/*.jsonl",
    "!.agents/memory/*.db",
    "!**/__pycache__/",
    "!**/*.pyc",
    "!apps/*/node_modules/",
    "!apps/*/node_modules/**",
    "!apps/*/.git/**",
    "!apps/*/fork/**",
    "!packages/**/node_modules/**",
    "!tools/**/node_modules/**",
    "!tools/**/__pycache__/**",
    "!tools/**/*.pyc"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "linux",
    "darwin",
    "android"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bash .agents/skills/galdr-ymirsystem/scripts/compliance-check.sh",
    "compliance": "bash .agents/skills/galdr-ymirsystem/scripts/compliance-check.sh",
    "prepack": "bin/desktop/app-build.sh && bin/forge/npm/pack-links.sh stage",
    "postpack": "bin/forge/npm/pack-links.sh restore",
    "postinstall": "bash bin/fleet/fleet-deploy.sh || true"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "zod": "^3.23.8"
  },
  "workspaces": [
    "apps/hlidskjalf"
  ],
  "allowScripts": {
    "electron@43.7.3": true,
    "electron@33.4.11": true,
    "electron@43.8.9": true
  }
}
