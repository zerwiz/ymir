{
  "name": "@zerwiz/ymir",
  "version": "0.1.34",
  "description": "Ymir — the single-tenant agent operating system. One command: curl -fsSL https://raw.githubusercontent.com/zerwiz/ymir/main/install.sh | bash  ·  or: npx @zerwiz/ymir  ·  or: npm i -g @zerwiz/ymir (if `ymir` is not found, the README has the three-line PATH cure)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zerwiz/ymir",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerwiz/ymir.git"
  },
  "bugs": {
    "url": "https://github.com/zerwiz/ymir/issues"
  },
  "keywords": [
    "agent",
    "agents",
    "ymir",
    "brokk",
    "omarchy",
    "wsl",
    "a2a",
    "mcp"
  ],
  "bin": {
    "ymir": "bin/ymir.js",
    "ymir-install": "bin/ymir-install.sh"
  },
  "files": [
    "bin/",
    ".agents/",
    "scripts/",
    "RULES/",
    "midgard/design-system/",
    "docs/",
    "packaging/",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "!**/node_modules/**",
    "!.agents/memory/kaia.engram*",
    "!.agents/memory/well/*.jsonl",
    "!.agents/memory/*.db",
    "!**/__pycache__/",
    "!**/*.pyc",
    ".pi/",
    ".opencode/",
    ".claude/",
    ".codex/",
    ".cursor/",
    "assets/",
    "data/",
    "deploy/",
    "apps/",
    "install.sh",
    "!apps/*/node_modules/",
    "!apps/*/node_modules/**",
    "!apps/*/.git/**",
    "!apps/*/fork/**"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bash .agents/skills/galdr-ymirsystem/scripts/compliance-check.sh",
    "compliance": "bash .agents/skills/galdr-ymirsystem/scripts/compliance-check.sh",
    "prepack": "bin/app-build.sh"
  },
  "dependencies": {
    "@zerwiz/smidja-factory": "^0.1.3"
  },
  "workspaces": [
    "apps/hlidskjalf",
    "apps/odrerir",
    "apps/sessrumnir"
  ]
}
